+fn check(f: cuda.Function, pf: cuda.Function, threads: u32, stream: cuda.Stream, in: In, rows: usize, out: u64, xs: u64) !void {
+    const d = stream.d;
+    const out_w = gdn.nv * 128 / 2; // bf16 [rows][nv * 128] as 32-bit words a row
+    const xs_w = gdn.nv * 128 / 32;
+    const st_w = gdn.nv * 128 * 128;
+    if (chk_out == null) {
+        chk_out = try cuda.DeviceBuffer.alloc(d, parts.max_chunk * out_w * 4);
+        chk_xs = try cuda.DeviceBuffer.alloc(d, parts.max_chunk * xs_w * 4);
+        chk_st = try cuda.DeviceBuffer.alloc(d, st_w * 4);
+        chk_cnt = try cuda.DeviceBuffer.alloc(d, 16);
+        try d.check(d.api.cuMemsetD8_v2(chk_cnt.?.ptr, 0, 16), "cuMemsetD8");
+    }
+    if (rows > parts.max_chunk) return launchOne(f, parts.gdn_fused_threads, stream, in, rows, out, xs, in.state_out);
