--- /dev/null
+++ b/zig/kernels/cuda/q38_gdn_prod.cuh
@@ -0,0 +1,241 @@
+// Flash Next prompt GDN, fn_gdn_fused with G producer groups of 128 threads (q38 round 11, TF_FLASHNEXT_Q38_GDN_PROD=G).
+// Measured on GB10: fn_gdn_fused's chain (256 threads, the state in registers) needs 1.5 ms per 3,072 rows, its 128 producer
+// threads (conv + SiLU + norms of 16 rows a batch) need 2.7 ms: the chain waits for them. Here the producers are G groups:
+//   G = 2: A forms q and k (conv, SiLU, their norms); B forms v, g, beta and the gated norm of the batch before.
+//   G = 3: A forms q, B forms k, C forms v, g, beta and the gated norm.
+// The chain and the producers are separate scopes (the chain's 64 state registers are not live in producer code, so 512 or 640
+// threads fit a CTA without spills). Every value is fn_gdn_fused's own expression in its own order: conv_rows is the same
+// function, the norms' warp sums run on the same lanes; only which thread computes a value changes.
+namespace gdn_fused2 {
+using namespace fn_gdn;
+using gdn_fused::STEPS;
+using gdn_fused::TPR;
+using gdn_fused::CH;
+using gdn_fused::PR;
+using gdn_fused::ROW;
+using gdn_fused::STAGE;
+using gdn_fused::SMEM;
+using gdn_fused::conv_rows;
+
+template <int ID>
+__device__ __forceinline__ void gbar() {
+    if constexpr (ID == 1) asm volatile("bar.sync 1, 128;\n" ::: "memory");
+    else if constexpr (ID == 2) asm volatile("bar.sync 2, 128;\n" ::: "memory");
+    else asm volatile("bar.sync 3, 128;\n" ::: "memory");
+}
+
+// rows r0 .. r0 + n - 1's channel block `c0` (q: hk * DK, k: NK * DK + hk * DK) into x[.][which]: front_batch's conv part
+__device__ __forceinline__ void conv_x(const __nv_bfloat16* __restrict__ P, const __nv_bfloat16* __restrict__ cs,
+                                       const __nv_bfloat16* __restrict__ cw, int r0, int n, int c0, int which, int p,
+                                       float (*x)[2][DK]) {
+    float o[STEPS];
+    conv_rows(P, cs, cw, r0, n, c0 + p, o);
+#pragma unroll
+    for (int j = 0; j < STEPS; ++j) if (j < n) x[j][which][p] = o[j];
+}
+
+// front_batch's norm of row j's q (which 0) or k (which 1) by one warp: the same lanes, the same warp sum
+__device__ __forceinline__ void norm_qk(int j, int which, int lane, unsigned char* base, float (*x)[2][DK]) {
+    float v4[4], ss = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        v4[i] = x[j][which][lane * 4 + i];
+        ss = ss + v4[i] * v4[i];
+    }
+    ss = warp_sum(ss);
+    float inv = 1.0f / sqrtf(ss + 1e-6f);
+    if (which == 0) inv = inv * (1.0f / sqrtf((float)DK));
+    float* dst = reinterpret_cast<float*>(base + j * ROW + (which == 0 ? DK * 4 : 0));   // stage: k first, then q
+#pragma unroll
+    for (int i = 0; i < 4; ++i) dst[lane * 4 + i] = v4[i] * inv;
+}
+
+// the rows' v, g and beta into the stage: front_batch's v / gate part
+__device__ __forceinline__ void front_v(const __nv_bfloat16* __restrict__ P, const __nv_bfloat16* __restrict__ cs,
+                                        const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log,
+                                        const float* __restrict__ dt_bias, int r0, int n, int hv, int p, unsigned char* base) {
+    float o[STEPS];
+    conv_rows(P, cs, cw, r0, n, 2 * NK * DK + hv * DV + p, o);
+#pragma unroll
+    for (int j = 0; j < STEPS; ++j) if (j < n) reinterpret_cast<float*>(base + j * ROW + 2 * DK * 4)[p] = o[j];
+    if (p < n) {
+        const int r = r0 + p;
+        const float b = __bfloat162float(P[(size_t)r * PW + C + NV * DV + hv]);
+        const float a = __bfloat162float(P[(size_t)r * PW + C + NV * DV + NV + hv]);
+        float* gbp = reinterpret_cast<float*>(base + p * ROW + (2 * DK + DV) * 4);
+        gbp[0] = expf(-expf(a_log[hv]) * softplusf_(a + dt_bias[hv]));
+        gbp[1] = bf(sigmoidf_(b));
+    }
+}
+
+// gdn_fused::norm_rows on barrier ID
+template <int ID>
+__device__ __forceinline__ void norm_rows(const float (*ys)[DV], const __nv_bfloat16* __restrict__ P,
+                                          const __nv_bfloat16* __restrict__ norm_w, float eps, __nv_bfloat16* __restrict__ out,
+                                          float* __restrict__ xs, int r0, int n, int hv, int p, float* rinv) {
+    const int warp = p >> 5, lane = p & 31;
+    for (int j = warp; j < n; j += PR / 32) {
+        float ss = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 4; ++i) {
+            const float y = ys[j][lane * 4 + i];
+            ss = ss + y * y;
+        }
+        ss = warp_sum(ss);
+        if (lane == 0) rinv[j] = 1.0f / sqrtf(ss / (float)DV + eps);
+    }
+    gbar<ID>();
+    float zs[STEPS];
+#pragma unroll
+    for (int j = 0; j < STEPS; ++j) zs[j] = j < n ? __bfloat162float(P[(size_t)(r0 + j) * PW + C + hv * DV + p]) : 0.0f;
+    const float nw = __bfloat162float(norm_w[p]);
+#pragma unroll
+    for (int j = 0; j < STEPS; ++j) {
+        if (j >= n) break;
+        const int r = r0 + j;
+        const float yn = bf(bf(ys[j][p] * rinv[j]) * nw);
+        const float z = zs[j];
+        const float o = bf(yn * sigmoidf_(z));
+        out[(size_t)r * NV * DV + hv * DV + p] = __float2bfloat16_rn(o);
+        const float gs = warp_sum(o);
+        if (lane == 0) xs[(size_t)r * (NV * DV / 32) + hv * (DV / 32) + warp] = gs;
+    }
+    gbar<ID>();
+}
+
+template <int G>
+__device__ __forceinline__ void producers(const __nv_bfloat16* __restrict__ P, const __nv_bfloat16* __restrict__ cs,
+                                          const __nv_bfloat16* __restrict__ cw, const float* __restrict__ a_log,
+                                          const float* __restrict__ dt_bias, int rows, const __nv_bfloat16* __restrict__ norm_w,
+                                          float eps, __nv_bfloat16* __restrict__ out, float* __restrict__ xs,
+                                          unsigned char* smem) {
+    unsigned char* stage = smem;
+    float (*ysb)[STEPS][DV] = reinterpret_cast<float (*)[STEPS][DV]>(smem + 2 * STAGE);
+    float (*xb)[2][DK] = reinterpret_cast<float (*)[2][DK]>(smem + 2 * STAGE + 2 * STEPS * DV * 4);
+    float* rinv = reinterpret_cast<float*>(smem + 2 * STAGE + 2 * STEPS * DV * 4 + STEPS * 2 * DK * 4);
+    const int hv = blockIdx.x, hk = hv / (NV / NK);
+    const int grp = (threadIdx.x - CH) / PR, p = (threadIdx.x - CH) % PR, warp = p >> 5, lane = p & 31;
+    const int batches = (rows + STEPS - 1) / STEPS;
+    auto fill = [&](int bi) {
+        const int r0 = bi * STEPS, n = min(STEPS, rows - r0);
+        unsigned char* base = stage + (bi & 1) * STAGE;
+        if (grp == G - 1) {
+            front_v(P, cs, cw, a_log, dt_bias, r0, n, hv, p, base);
+        } else if constexpr (G == 2) {
+            conv_x(P, cs, cw, r0, n, hk * DK, 0, p, xb);
+            conv_x(P, cs, cw, r0, n, NK * DK + hk * DK, 1, p, xb);
+            gbar<1>();
+            for (int task = warp; task < 2 * n; task += PR / 32) norm_qk(task >> 1, task & 1, lane, base, xb);
+        } else if (grp == 0) {
+            conv_x(P, cs, cw, r0, n, hk * DK, 0, p, xb);
+            gbar<1>();
+            for (int j = warp; j < n; j += PR / 32) norm_qk(j, 0, lane, base, xb);
+        } else {
+            conv_x(P, cs, cw, r0, n, NK * DK + hk * DK, 1, p, xb);
+            gbar<2>();
+            for (int j = warp; j < n; j += PR / 32) norm_qk(j, 1, lane, base, xb);
+        }
+    };
+    if (batches > 0) fill(0);
+    __syncthreads();
+    for (int bi = 0; bi < batches; ++bi) {
+        if (bi + 1 < batches) fill(bi + 1);
+        if (grp == G - 1 && bi >= 1) norm_rows<3>(ysb[(bi - 1) & 1], P, norm_w, eps, out, xs, (bi - 1) * STEPS, STEPS, hv, p, rinv);
+        __syncthreads();
+    }
+    if (grp == G - 1 && batches > 0)
+        norm_rows<3>(ysb[(batches - 1) & 1], P, norm_w, eps, out, xs, (batches - 1) * STEPS, rows - (batches - 1) * STEPS, hv, p, rinv);
+}
+
+// gdn_fused::run's chain threads, nothing else in scope
+__device__ __forceinline__ void chain(const float* state_in, float* state_out, int rows, float* __restrict__ ys_out,
+                                      unsigned char* smem) {
+    unsigned char* stage = smem;
+    float (*ysb)[STEPS][DV] = reinterpret_cast<float (*)[STEPS][DV]>(smem + 2 * STAGE);
+    const int hv = blockIdx.x;
+    const int batches = (rows + STEPS - 1) / STEPS;
+    constexpr int L = 32 / TPR;
+    const int row = threadIdx.x / TPR, t = threadIdx.x % TPR;
+    const size_t sbase = (size_t)hv * DV * DK + (size_t)row * DK;
+    float s[L][4];
+#pragma unroll
+    for (int l = 0; l < L; ++l)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) s[l][i] = state_in[sbase + (l * TPR + t) * 4 + i];
+    __syncthreads();
+    for (int bi = 0; bi < batches; ++bi) {
+        const int r0 = bi * STEPS, n = min(STEPS, rows - r0);
+        const unsigned char* base = stage + (bi & 1) * STAGE;
+        for (int rr = 0; rr < n; ++rr) {
+            const unsigned char* d = base + rr * ROW;
+            const float vv = reinterpret_cast<const float*>(d + 2 * DK * 4)[row];
+            const float2 gbv = *reinterpret_cast<const float2*>(d + (2 * DK + DV) * 4);
+            const float g = gbv.x, beta = gbv.y;
+            float x[L];
+#pragma unroll
+            for (int l = 0; l < L; ++l) {
+                const float4 k4 = *reinterpret_cast<const float4*>(d + (l * TPR + t) * 16);
+                const float kk[4] = {k4.x, k4.y, k4.z, k4.w};
+                float kv = 0.0f;
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    s[l][i] = s[l][i] * g;
+                    kv = kv + s[l][i] * kk[i];
+                }
+                x[l] = kv;
+            }
+            const float kv = gdn_tpr::tree<TPR>(x);
+            const float delta = (vv - kv) * beta;
+            // the same row through a pointer the compiler cannot match with `d`: k is read again here instead of being held in
+            // 64 registers across the tree (fn_gdn_fused holds it: 166 registers a thread, which caps a CTA at 384 threads)
+            const unsigned char* d2;
+            asm volatile("mov.u64 %0, %1;\n" : "=l"(d2) : "l"(d));
+#pragma unroll
+            for (int l = 0; l < L; ++l) {
+                const float4 k4 = *reinterpret_cast<const float4*>(d2 + (l * TPR + t) * 16);
+                const float4 q4 = *reinterpret_cast<const float4*>(d2 + DK * 4 + (l * TPR + t) * 16);
+                const float kk[4] = {k4.x, k4.y, k4.z, k4.w}, qq[4] = {q4.x, q4.y, q4.z, q4.w};
+                float o = 0.0f;
+#pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    s[l][i] = s[l][i] + kk[i] * delta;
+                    o = o + s[l][i] * qq[i];
+                }
+                x[l] = o;
+            }
+            const float o = bf(gdn_tpr::tree<TPR>(x));
+            if (t == 0) {
+                ysb[bi & 1][rr][row] = o;
+                if (ys_out) ys_out[((size_t)(r0 + rr) * NV + hv) * DV + row] = o;
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int l = 0; l < L; ++l)
+#pragma unroll
+        for (int i = 0; i < 4; ++i) state_out[sbase + (l * TPR + t) * 4 + i] = s[l][i];
+}
+}  // namespace gdn_fused2
+
+#define FN_GDN_FUSED_P(NAME, G)                                                                                              \
+    extern "C" __global__ void __launch_bounds__(gdn_fused::CH + G * gdn_fused::PR) NAME(                                     \
+        const __nv_bfloat16* __restrict__ P, const __nv_bfloat16* __restrict__ cs, const __nv_bfloat16* __restrict__ cw,     \
+        const float* __restrict__ a_log, const float* __restrict__ dt_bias, const float* state_in, float* state_out,          \
+        int rows, const __nv_bfloat16* __restrict__ norm_w, float eps, __nv_bfloat16* __restrict__ out,                      \
+        float* __restrict__ xs, float* __restrict__ ys_out) {                                                                \
+        extern __shared__ __align__(16) unsigned char smem[];                                                                \
+        if (threadIdx.x < gdn_fused::CH) gdn_fused2::chain(state_in, state_out, rows, ys_out, smem);                          \
+        else gdn_fused2::producers<G>(P, cs, cw, a_log, dt_bias, rows, norm_w, eps, out, xs, smem);                           \
+    }
+FN_GDN_FUSED_P(fn_gdn_fused_p2, 2)
+FN_GDN_FUSED_P(fn_gdn_fused_p3, 3)
+
+// Check mode (TF_FLASHNEXT_Q38_GDN_PROD=12 / 13): 32-bit words that differ between two buffers, added to *count.
+extern "C" __global__ void fn_q38_cmp_words(const uint32_t* __restrict__ a, const uint32_t* __restrict__ b, long long words,
+                                            unsigned int* count) {
+    unsigned int diff = 0;
+    for (long long i = (long long)blockIdx.x * blockDim.x + threadIdx.x; i < words; i += (long long)gridDim.x * blockDim.x)
+        diff += a[i] != b[i];
+    if (diff) atomicAdd(count, diff);
+}
