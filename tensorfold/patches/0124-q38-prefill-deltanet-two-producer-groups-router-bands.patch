+    try launchOne(pf, threads, stream, in, rows, out, xs, in.state_out);
+    try cmpWords(stream, out, chk_out.?.ptr, rows * out_w, chk_cnt.?.ptr);
+    try cmpWords(stream, xs, chk_xs.?.ptr, rows * xs_w, chk_cnt.?.ptr);
+    try cmpWords(stream, in.state_out, chk_st.?.ptr, st_w, chk_cnt.?.ptr);
