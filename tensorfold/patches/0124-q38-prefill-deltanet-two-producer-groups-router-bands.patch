+/// TF_FLASHNEXT_Q38_XPLAN=FILE (q38 measuring aid, off unless set): the expert plan of prompt passes of >= 1,024 rows, the first
+/// TF_FLASHNEXT_Q38_XPLAN_MAX (default 480) of them: one record a MoE block = u32 magic 0x58504C4E, rows, pairs an item, items,
+/// distinct experts, then the items [items][3] i32 (expert, first, count). It waits for the stream; values never change.
+pub const Xplan = struct {
+    var state: i8 = -1;
+    var fd: c_int = -1;
+    var left: usize = 480;
+    var host: [3 * 8192]i32 = undefined;
+
+    pub fn on() bool {
+        if (state < 0) {
+            state = 0;
+            if (std.c.getenv("TF_FLASHNEXT_Q38_XPLAN")) |e| {
+                if (std.c.getenv("TF_FLASHNEXT_Q38_XPLAN_MAX")) |m| left = std.fmt.parseInt(usize, std.mem.span(m), 10) catch left;
+                fd = open(e, 0x441, @as(c_int, 0o644));
+                if (fd >= 0) state = 1;
+                std.debug.print("q38: expert plans to {s} (fd {d}, max blocks {d})\n", .{ std.mem.span(e), fd, left });
+            }
+        }
+        return state == 1 and left > 0;
+    }
+
+    pub fn dump(self: anytype, plan: cuda.grouped.Plan, n: usize, tile: usize) !void {
+        const d = self.stream.d;
+        try self.stream.synchronize();
+        var c: [2]i32 = .{ 0, 0 };
+        try d.check(d.api.cuMemcpyDtoH_v2(&c, plan.counts, 8), "cuMemcpyDtoH");
+        const items: usize = @intCast(@max(0, c[0]));
+        if (items == 0 or items > host.len / 3) return;
+        try d.check(d.api.cuMemcpyDtoH_v2(&host, plan.items, items * 12), "cuMemcpyDtoH");
+        const head = [5]u32{ 0x58504C4E, @intCast(n), @intCast(tile), @intCast(items), @intCast(@max(0, c[1])) };
+        _ = write(fd, std.mem.asBytes(&head).ptr, 20);
+        _ = write(fd, std.mem.sliceAsBytes(host[0 .. items * 3]).ptr, items * 12);
+        left -|= 1;
+    }
+};
+
