@@ -14,15 +14,92 @@ pub fn on() bool {
 /// fn_gdn_fused's inputs: projection rows, conv window and taps, gate parameters, the state and where it goes.
 pub const In = struct { proj: u64, conv: u64, cw: u64, a_log: u64, dt: u64, state: u64, state_out: u64, norm: u64 };
 
-/// fn_gdn_front, fn_gdn_chain_tpr and fn_gdn_norm over `rows` rows in one launch (their bits): out and xs.
-pub fn launch(f: cuda.Function, stream: cuda.Stream, in: In, rows: usize, out: u64, xs: u64) !void {
+/// q38 round 11, TF_FLASHNEXT_Q38_GDN_PROD=G (default 0 = fn_gdn_fused as it is): G = 2 / 3 runs fn_gdn_fused_p2 / _p3, the same
+/// arithmetic with G producer groups of 128 threads (kernels/cuda/q38_gdn_prod.cuh: the chain waited for its producers).
+/// 12 / 13 = check mode: fn_gdn_fused runs first into scratch, then the new kernel, and out, xs and the end state are compared
+/// on the device word by word (one line a 36 launches: "q38 gdnprod check").
+pub var p2: ?cuda.Function = null;
+pub var p3: ?cuda.Function = null;
+pub var cmp: ?cuda.Function = null;
+var prod_mode: i32 = -1;
+var chk_out: ?cuda.DeviceBuffer = null;
+var chk_xs: ?cuda.DeviceBuffer = null;
+var chk_st: ?cuda.DeviceBuffer = null;
+var chk_cnt: ?cuda.DeviceBuffer = null;
+var chk_launches: u64 = 0;
+var chk_words: u64 = 0;
+var chk_diff: u64 = 0;
+
+pub fn prod() i32 {
+    if (prod_mode < 0) {
+        prod_mode = 0;
+        if (std.c.getenv("TF_FLASHNEXT_Q38_GDN_PROD")) |e| prod_mode = std.fmt.parseInt(i32, std.mem.span(e), 10) catch 0;
+        const g = @mod(prod_mode, 10);
+        if ((g != 2 and g != 3) or (g == 2 and p2 == null) or (g == 3 and p3 == null) or (prod_mode >= 10 and cmp == null)) prod_mode = 0;
+        if (prod_mode != 0) std.debug.print("q38 gdn prod: {d} producer groups{s}\n", .{ g, if (prod_mode >= 10) " (check mode: the stock kernel runs too)" else "" });
+    }
+    return prod_mode;
