+/// fn_gdn_front, fn_gdn_chain_tpr and fn_gdn_norm over `rows` rows in one launch (their bits): out and xs.
+pub fn launch(f: cuda.Function, stream: cuda.Stream, in: In, rows: usize, out: u64, xs: u64) !void {
+    const mode = prod();
+    if (mode != 0) {
+        const g: u32 = @intCast(@mod(mode, 10));
+        const pf = if (g == 2) p2.? else p3.?;
+        const threads: u32 = 256 + g * 128;
+        if (mode >= 10) return check(f, pf, threads, stream, in, rows, out, xs);
+        return launchOne(pf, threads, stream, in, rows, out, xs, in.state_out);
+    }
+    return launchOne(f, parts.gdn_fused_threads, stream, in, rows, out, xs, in.state_out);
