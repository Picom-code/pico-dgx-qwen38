+        /// q38 (TF_FLASHNEXT_Q38_ATTN_LANES; upstream #1739's idea): a shared round's attention layer for its text lanes in one launch
+        /// a kernel (prep, pool, scores, selection, chunks, merge), up to 16 lanes a launch, fp8 caches and bf16 caches (lanes of at
+        /// most 16 rows: the per-lane launch's kernel form) as separate groups. Every block runs the per-lane kernel's program on
+        /// its lane's caches and positions; the round's buffers are indexed by the pass row, the address the per-lane launches reach
+        /// through their offsets (scores, partials and key lists are scratch: there the pass row replaces the lane's row). Returns
+        /// the lanes taken as bits; the rest (media, a lone lane of a kind, other shapes) run a lane at a time as before.
+        fn attnLanesBatched(self: *Self, lw: *const Layer, ai: usize, pa: u64) !u64 {
+            if (comptime !@hasDecl(Tri, "lanesGlue")) return 0;
+            if (!knobs.q38AttnLanes() or self.lanes.len < 2 or self.rows > att_rows or index_heads != 4) return 0;
+            const g = self.tri.lanesGlue() orelse return 0;
+            const s = self.s;
+            const scores = self.lanes[0].seq.scores;
+            var taken: u64 = 0;
+            for ([_]bool{ true, false }) |kv8| {
+                var tab: glue_mod.AttnLanes = .{};
+                var cnt: usize = 0;
+                var bits: u64 = 0;
+                var hi: usize = 0;
+                var max_rows: usize = 0;
+                var max_blocks: usize = 0;
+                var chunks: usize = 0;
+                var nb: usize = 0;
+                var row0: usize = 0;
+                for (self.lanes, 0..) |l, i| {
+                    const r0 = row0;
+                    row0 += l.rows;
+                    const last = i + 1 == self.lanes.len;
+                    const ends = l.pos + l.rows;
+                    const fits = i < 64 and l.seq.media == null and (l.seq.kv == .fp8) == kv8 and l.rows > 0 and ends <= l.seq.cap and ai < l.seq.kc.len and l.seq.scores == scores and (kv8 or l.rows <= glue_mod.ahead_rows);
+                    if (fits) {
+                        tab.lane[cnt] = .{ .kc = l.seq.kc[ai].ptr, .vc = l.seq.vc[ai].ptr, .ikc = l.seq.ikc[ai].ptr, .pooled = l.seq.pooled[ai].ptr, .pos = cint(l.pos), .rows = cint(l.rows), .row0 = cint(r0) };
+                        cnt += 1;
+                        bits |= @as(u64, 1) << @intCast(i);
+                        hi = r0 + l.rows;
+                        max_rows = @max(max_rows, l.rows);
+                        const lnb = scoreStride(l.seq.cap);
+                        nb = @max(nb, lnb);
+                        if (ends / ratio > top) max_blocks = @max(max_blocks, @min(lnb, cdiv(ends, ratio)));
+                        chunks = @max(chunks, cdiv(@min(ends, wt.dense_keys), 512));
+                    }
+                    if (cnt == glue_mod.attn_lanes_max or (last and cnt > 0)) {
