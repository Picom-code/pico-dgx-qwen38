diff --git a/zig/kernels/cuda/q38_attn_lanes.cuh b/zig/kernels/cuda/q38_attn_lanes.cuh
new file mode 100644
index 0000000..68bf1ca
--- /dev/null
+++ b/zig/kernels/cuda/q38_attn_lanes.cuh
@@ -0,0 +1,21 @@
+// q38 (TF_FLASHNEXT_Q38_ATTN_LANES): a shared round's attention in one launch a kernel for up to 16 lanes instead of a launch a
+// lane. The idea and the kernel split follow TensorFold's TF_FLASHNEXT_ATTN_LANES (upstream #1739, thanks to @optimisme); this form
+// passes the lane table by value (no upload) and also serves fp8 caches. Every block runs the per-lane kernel's program on the
+// same addresses: a row's block finds its lane, then its lane's caches and position.
+#pragma once
+#define Q38_ATTN_LANES_MAX 16
+struct FnAttnLane {
+    unsigned long long kc, vc, ikc, pooled;   // the lane's caches of this attention layer
+    int pos, rows, row0, pad;                 // its first position, its rows, its first row in the pass
+};
+struct FnAttnLanes {
+    FnAttnLane lane[Q38_ATTN_LANES_MAX];
+    int count;
+    int pad;
+};
+// the table lane that holds pass row r, or -1 (a row of a lane that runs by itself)
+__device__ __forceinline__ int q38_lane_of(const FnAttnLanes& T, int r) {
+    for (int i = 0; i < T.count; ++i)
+        if (r >= T.lane[i].row0 && r < T.lane[i].row0 + T.lane[i].rows) return i;
+    return -1;
+}
