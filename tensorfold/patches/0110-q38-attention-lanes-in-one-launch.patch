+                            const st = self.tri.s;
+                            try g.attnPrepLanes(st, kv8, &tab, pa, lw.q_scale.ptr, lw.k_scale.ptr, lw.i_scale.ptr, s.inv, s.q, s.iq, eps, hi);
+                            try g.qsaPoolLanes(st, &tab, lw.ik_scale.ptr, s.inv, eps, max_rows);
+                            if (max_blocks > 0) try g.qsaScoresLanes(st, &tab, s.iq, scores, nb, max_rows, max_blocks);
+                            var a: cuda.Args = .{};
+                            a.add(tab);
+                            a.add(scores);
+                            a.add(s.qids);
+                            a.add(s.qnk);
+                            a.add(s.qspr);
+                            a.add(cint(nb));
+                            a.add(cint(idw));
+                            a.add(cint(top));
+                            a.add(cint(ratio));
+                            try cuda.launch.launch(self.k.select_lanes, .{ .grid = .{ .x = @intCast(hi) }, .block = .{ .x = 1024 } }, self.stream, &a);
+                            try g.attnChunksLanes(st, kv8, &tab, s.q, s.po, s.pm, s.pl, s.qids, s.qnk, s.qspr, hi, kv_heads, chunks);
+                            try g.attnMergeLanes(st, &tab, s.po, s.pm, s.pl, s.ao, s.qnk, s.qspr, hi, kv_heads);
+                            taken |= bits;
+                        }
+                        tab = .{};
+                        cnt = 0;
+                        bits = 0;
+                        hi = 0;
+                        max_rows = 0;
+                        max_blocks = 0;
+                        chunks = 0;
+                        nb = 0;
+                    }
