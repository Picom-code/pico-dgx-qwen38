+extern "c" fn open(path: [*:0]const u8, flags: c_int, ...) c_int;
+extern "c" fn write(fd: c_int, buf: [*]const u8, n: usize) isize;
+
+const MtpDump = struct {
+    var state: i8 = -1;
+    var fd: c_int = -1;
+    var host: [wide * 2]u8 = undefined;
+    var cands: mtp.Cands = undefined;
+    var state2: i8 = -1;
+    var fd2: c_int = -1;
+    /// TF_FLASHNEXT_Q38_MTPDUMP2=FILE: the draft head's input row ([dims] bf16, what the head's rows multiply) of every scored head call.
+    fn on2() bool {
+        if (state2 < 0) {
+            state2 = 0;
+            if (std.c.getenv("TF_FLASHNEXT_Q38_MTPDUMP2")) |e| {
+                fd2 = open(e, 0x441, @as(c_int, 0o644));
+                if (fd2 >= 0) state2 = 1;
+                std.debug.print("q38: mtp head-input dump fd {d}\n", .{fd2});
+            }
+        }
+        return state2 == 1;
+    }
+    fn mixed(stream: cuda.Stream, ptr: u64) !void {
+        try download(stream, host[0 .. dims * 2], ptr);
+        _ = write(fd2, &host, dims * 2);
+    }
+    fn on() bool {
+        if (state < 0) {
+            state = 0;
+            if (std.c.getenv("TF_FLASHNEXT_Q38_MTPDUMP")) |e| {
+                fd = open(e, 0x441, @as(c_int, 0o644));
+                if (fd >= 0) state = 1;
+                std.debug.print("q38: mtp dump fd {d}\n", .{fd});
+            }
+        }
+        return state == 1;
+    }
+};
