diff --git a/zig/kernels/cuda/flashnext_hcf.cu b/zig/kernels/cuda/flashnext_hcf.cu
index 6a8985d..6e4bdbe 100644
--- a/zig/kernels/cuda/flashnext_hcf.cu
+++ b/zig/kernels/cuda/flashnext_hcf.cu
@@ -759,3 +759,203 @@ extern "C" __global__ void __launch_bounds__(256) fn_hcn_peak(float* OUT, int it
     }
 HCN_UP_DBG(fn_hcn_up3_k5_gemm, 3, 5, 1)
 HCN_UP_DBG(fn_hcn_up3_k5_epi, 3, 5, 2)
+
+// ---- q38: the native read-out in DECODE geometry (few rows), two launches instead of five ----
+//
+// The exact chain for decode rows is fn_hc_normalize2 -> qmmf_kernel<BF16, 16, 64, 1, 4, ST, F32, CLUSTER> (down: 64 columns and one
+// K slice a block, the SK slices of a column tile met in a cluster and added in slice order) -> fn_hc_reduce_act (SK 1) ->
+// qmmf up (bf16) -> fn_hc_dense_mix2.
+//   fn_q38_hcdn: the down block of that chain with (a) its input stage formed in shared memory from the streams (fn_hc_normalize2's
+//   expression, one bf16 rounding) instead of copied from the normed rows, and (b) fn_hc_reduce_act's per-column arithmetic applied
+//   to the block's finished fp32 sums. The weight stages, the mma order (one m16n8k16 a k16 step, K ascending, from a zero
+//   accumulator), the slice order of the cluster sum and every rounding point are the chain's, so every output byte is the chain's.
+//   fn_hcn_up1_k5: hcn::upmix_body at one 16-row tile (the prompt tiles' up + mix kernel, already byte for byte the chain's).
+#include <cooperative_groups.h>
+namespace q38hc {
+using namespace qmm_frag;
+using tf_glue::bf;
+using tf_glue::rbf;
+
+__device__ __forceinline__ float bsig(float x) { return rbf(tf_glue::tf_sigmoid(x)); }
+__device__ __forceinline__ float bsilu(float x) { return rbf(tf_glue::tf_silu(x)); }
+
+template <int STAGES, int BN>
+__device__ __forceinline__ void hcdn_body(const __nv_bfloat16* __restrict__ H, const float* __restrict__ PSS,
+                                          const float* __restrict__ SCALE, const unsigned char* __restrict__ w,
+                                          __nv_bfloat16* __restrict__ ACT, float* __restrict__ XS, __nv_bfloat16* __restrict__ INJ,
+                                          float* __restrict__ PART, int M, int N, int K, int SK, int D, int NC, int SS, int LOW,
+                                          int HAS_INJ, float eps, float scale) {
+    constexpr int GS = 64, BM = 16, WN = 4, THREADS = 128, NT = BN / WN / 8, ROW = GS * 2, CHUNKS = ROW / 16;
+    static_assert(BN == 64 || BN == 32, "a 64-column tile of the packed weights, or its half (n8 tiles 0-3 / 4-7)");
+    constexpr int X = BM * ROW, W = BN * GS * 2, STAGE = (X + W + 127) / 128 * 128;
+    extern __shared__ __align__(128) unsigned char buf[];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5, wn = warp % WN;
+    const int KG = K / GS, per = KG / SK;
+    const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN, slice = blockIdx.z, g0 = slice * per;
+
+    // this thread's row of the input stage (one 16-byte chunk a thread a stage) and that row's 1 / rms in the slice's first stream
+    const int xr = tid / CHUNKS, xch = tid % CHUNKS, xrow = m0 + xr;
+    const int st0 = (g0 * GS) / D;
+    float rinv0 = 0.0f;
+    auto stage = [&](int s) { return buf + s * STAGE; };
+    auto loadX = [&](int s, int g) {
+        unsigned char* p = stage(s) + xr * ROW + swz<CHUNKS>(xr, xch) * 16;
+        uint4 o = make_uint4(0u, 0u, 0u, 0u);
+        if (xrow < M) {
+            const int k0 = g * GS + xch * 8, st = k0 / D;
+            const float rv = st == st0 ? rinv0 : hcn::rinv_of(PSS, xrow, st, NC, SS, D, eps);
+            const uint4 hv = *reinterpret_cast<const uint4*>(H + static_cast<size_t>(xrow) * K + k0);
+            const float4 s0 = *reinterpret_cast<const float4*>(SCALE + k0);
+            const float4 s1 = *reinterpret_cast<const float4*>(SCALE + k0 + 4);
+            const float sc[8] = {s0.x, s0.y, s0.z, s0.w, s1.x, s1.y, s1.z, s1.w};
+            const uint32_t hw[4] = {hv.x, hv.y, hv.z, hv.w};
+            uint32_t ow[4];
+#pragma unroll
+            for (int q = 0; q < 4; ++q) {
+                const __nv_bfloat162 h2 = *reinterpret_cast<const __nv_bfloat162*>(&hw[q]);
+                const __nv_bfloat162 n2 = __halves2bfloat162(__float2bfloat16_rn(__fmul_rn(__fmul_rn(bf(h2.x), rv), sc[2 * q])),
+                                                             __float2bfloat16_rn(__fmul_rn(__fmul_rn(bf(h2.y), rv), sc[2 * q + 1])));
+                ow[q] = *reinterpret_cast<const uint32_t*>(&n2);
+            }
+            o = make_uint4(ow[0], ow[1], ow[2], ow[3]);
+        }
+        *reinterpret_cast<uint4*>(p) = o;
+    };
+    auto loadW = [&](int s, int g) {
+        unsigned char* pw = stage(s) + X;
+        constexpr int TILE_BYTES = 64 * GS * 2;
+        const int half = (n0 % 64) / 32;  // 0 for 64-column tiles
+        for (int c = tid; c < W / 16; c += THREADS)
+            cp16(pw + c * 16, w + (static_cast<size_t>(n0 / 64) * KG + g) * TILE_BYTES + half * (TILE_BYTES / 2) + c * 16);
+    };
+
+    float acc[NT][4];
+#pragma unroll
+    for (int j = 0; j < NT; ++j)
+#pragma unroll
+        for (int e = 0; e < 4; ++e) acc[j][e] = 0.0f;
+    grid_launch();
+#pragma unroll
+    for (int s = 0; s < STAGES - 1; ++s)
+        if (s < per) loadW(s, g0 + s);
+    grid_wait();
+    if (xrow < M) rinv0 = hcn::rinv_of(PSS, xrow, st0, NC, SS, D, eps);
+#pragma unroll
+    for (int s = 0; s < STAGES - 1; ++s) {
+        if (s < per) loadX(s, g0 + s);
+        commit();
+    }
+    for (int it = 0; it < per; ++it) {
+        wait<STAGES - 2>();
+        __syncthreads();
+        const int next = it + STAGES - 1;
+        if (next < per) {
+            loadX(next % STAGES, g0 + next);
+            loadW(next % STAGES, g0 + next);
+        }
+        commit();
+        const unsigned char* p = stage(it % STAGES);
+        const unsigned char* pw = p + X;
+#pragma unroll
+        for (int kt = 0; kt < GS / 16; ++kt) {
+            uint32_t a[4];
+            {
+                const int r = (lane & 7) + ((lane >> 3) & 1) * 8;
+                const int ch = kt * 2 + (lane >> 4);
+                ldmatrix4(a, p + r * ROW + swz<CHUNKS>(r, ch) * 16);
+            }
+#pragma unroll
+            for (int j = 0; j < NT; ++j) {
+                const uint2 v = reinterpret_cast<const uint2*>(pw)[((wn * NT + j) * 4 + kt) * 32 + lane];
+                mma(acc[j], a, v.x, v.y);
+            }
+        }
+    }
+    wait<0>();
+    __syncthreads();
+#if __CUDA_ARCH__ < 900
+    __trap();
+#else
+    auto cluster = cooperative_groups::this_cluster();
+    float* mine = reinterpret_cast<float*>(buf);
+    if (slice != 0) {
+#pragma unroll
+        for (int j = 0; j < NT; ++j)
+#pragma unroll
+            for (int e = 0; e < 4; ++e) mine[(j * 4 + e) * THREADS + tid] = acc[j][e];
+    }
+    cluster.sync();
+    if (slice == 0) {
+        for (int peer = 1; peer < SK; ++peer) {
+            const float* theirs = cluster.map_shared_rank(mine, peer);
+#pragma unroll
+            for (int j = 0; j < NT; ++j)
+#pragma unroll
+                for (int e = 0; e < 4; ++e) acc[j][e] = acc[j][e] + theirs[(j * 4 + e) * THREADS + tid];
+        }
+    }
+    cluster.sync();
+    if (slice != 0) return;
+#endif
+    // the block's finished sums [16 rows, 64 columns]: fn_hc_reduce_act's column arithmetic (SK 1), then its sums of 32
+    float* a_s = reinterpret_cast<float*>(buf);
+#pragma unroll
+    for (int j = 0; j < NT; ++j) {
+        const int cl = wn * (BN / WN) + j * 8 + (lane & 3) * 2;
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {
+            const int rl = (lane >> 2) + h * 8, row = m0 + rl;
+#pragma unroll
+            for (int e = 0; e < 2; ++e) {
+                const int c = n0 + cl + e;
+                const float v0 = acc[j][2 * h + e] * scale;
+                if (row >= M || c >= N) continue;
+                if (PART) PART[static_cast<size_t>(row) * N + c] = v0;
+                const float v = rbf(__fdiv_rn(rbf(v0), static_cast<float>(SS)));
+                if (c < LOW) {
+                    const float a = bsilu(v);
+                    ACT[static_cast<size_t>(row) * LOW + c] = __float2bfloat16_rn(a);
+                    a_s[rl * BN + cl + e] = a;
+                } else if (HAS_INJ && c < LOW + SS) {
+                    INJ[static_cast<size_t>(row) * SS + (c - LOW)] = __float2bfloat16_rn(__fmul_rn(2.0f, bsig(v)));
+                }
+            }
+        }
+    }
+    __syncthreads();
+    if (tid < BM * 2) {
+        const int rl = tid >> 1, gi = tid & 1, c0 = n0 + gi * 32;
+        if (gi * 32 < BN && m0 + rl < M && c0 < LOW) {
+            float sum = 0.0f;
+            for (int k = 0; k < 32; ++k) sum = __fadd_rn(sum, a_s[rl * BN + gi * 32 + k]);
+            XS[static_cast<size_t>(m0 + rl) * (LOW / 32) + c0 / 32] = sum;
+        }
+    }
+}
+
+}  // namespace q38hc
+
+#define Q38_HCDN(NAME, ST, BNC)                                                                                                \
+    extern "C" __global__ void __launch_bounds__(128) NAME(                                                               \
+        const __nv_bfloat16* __restrict__ H, const float* __restrict__ PSS, const float* __restrict__ SCALE,              \
+        const unsigned char* __restrict__ W, __nv_bfloat16* __restrict__ ACT, float* __restrict__ XS,                     \
+        __nv_bfloat16* __restrict__ INJ, float* __restrict__ PART, int M, int N, int K, int SK, int D, int NC, int SS,    \
+        int LOW, int HAS_INJ, float eps, float scale) {                                                                    \
+        q38hc::hcdn_body<ST, BNC>(H, PSS, SCALE, W, ACT, XS, INJ, PART, M, N, K, SK, D, NC, SS, LOW, HAS_INJ, eps, scale);     \
+    }
+Q38_HCDN(fn_q38_hcdn4, 4, 64)
+Q38_HCDN(fn_q38_hcdn3, 3, 64)
+Q38_HCDN(fn_q38_hcdn6, 6, 64)
+Q38_HCDN(fn_q38_hcdn3h, 3, 32)
+Q38_HCDN(fn_q38_hcdn4h, 4, 32)
+Q38_HCDN(fn_q38_hcdn2, 2, 64)
+Q38_HCDN(fn_q38_hcdn2h, 2, 32)
+HCN_UP(fn_hcn_up1_k5, 1, 5)
+
+// q38 check aid: words of a and b that differ, and words compared (two 64-bit counters).
+extern "C" __global__ void fn_q38_cmp16(const uint16_t* __restrict__ A, const uint16_t* __restrict__ B, long long n,
+                                        unsigned long long* __restrict__ CNT) {
+    const long long i = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i == 0) atomicAdd(CNT + 1, static_cast<unsigned long long>(n));
+    if (i < n && A[i] != B[i]) atomicAdd(CNT, 1ull);
+}
