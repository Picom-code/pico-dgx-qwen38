+
+/// q38: a lone head CHAIN whose drafts all agree with the context match's continuation `copy` gets the next tokens of that
+/// continuation appended (at most `cap`), still a chain: the backend verifies it as any window. Drafts only.
+pub fn extendChain(e: *Engine, p: *Plan, copy: []const u32, cap: usize) !void {
+    const first = p.count();
+    if (p.held > 0 or p.parents != null or first == 0 or copy.len <= first) return;
+    if (!std.mem.eql(u32, copy[0..first], p.tokens[0..first])) return;
+    const limit: usize = @intCast(@max(1, @min(e.cfg.family_width, e.cfg.batch_rows, p.stream.draftRoom())));
+    const room = @min(limit -| (first + 1), cap);
+    const extra = copy[first..@min(copy.len, first + room)];
+    if (extra.len == 0) return;
+    const a = e.arena.allocator();
+    const parents = try a.alloc(i32, first + extra.len);
+    for (parents, 0..) |*up, i| up.* = @as(i32, @intCast(i)) - 1;
+    p.tokens = try std.mem.concat(a, u32, &.{ p.tokens, extra });
+    p.parents = parents;
+    p.branch_from = @intCast(first + 1);
+    p.context_copy = true;
+}
