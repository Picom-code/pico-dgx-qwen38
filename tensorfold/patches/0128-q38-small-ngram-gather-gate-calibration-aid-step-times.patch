+/// TF_FLASHNEXT_Q38_GCAL=FILE (q38 round 11; default unset = stock): a calibration of the lone chain's stop rule. The rule multiplies the
+/// draft head's probabilities and stops below a line, i.e. it reads them as "this draft will be kept"; measured on always-deep logs the
+/// head is over-confident (a drawn token of probability 0.7-0.8 is kept 0.52 of the time when sampling), and a sampled draw that is not
+/// the head's best token is kept more often than a best token of the same probability. FILE holds, a line each:
+///   g  x:y x:y ...   greedy chains: the head's probability x reads as y (piecewise linear between the knots, flat outside; x rising)
+///   st x:y ...       sampled chains, the drawn token is the head's best
+///   sn x:y ...       sampled chains, the drawn token is not the head's best
+///   set NAME VALUE   the lines that go with the calibrated product: c_g stop2_g deep_p_g deep_base_g (greedy), c_s stop2_s deep_p_s
+///                    deep_base_s (sampled); a name not set keeps the stock value
+/// Knob-file words: gcal=0 switches it off; gcal_c, gcal_stop2, gcal_deep_p (thousandths) and gcal_deep_base override the lines of
+/// whichever chain runs. Drafts only: which drafts are proposed changes, every kept token is still the main model's own.
+pub const GCal = struct {
+    pub const max_knots = 40;
+    n: [3]usize = .{ 0, 0, 0 },
+    x: [3][max_knots]f64 = undefined,
+    y: [3][max_knots]f64 = undefined,
+    /// [greedy, sampled] x [c, stop2, deep_p, deep_base]; negative: not set
+    thr: [2][4]f64 = .{ .{ -1, -1, -1, -1 }, .{ -1, -1, -1, -1 } },
+
+    pub fn map(c: *const GCal, kind: usize, p: f64) f64 {
+        const n = c.n[kind];
+        if (n == 0) return p;
+        const xs = c.x[kind][0..n];
+        const ys = c.y[kind][0..n];
+        if (!(p > xs[0])) return ys[0];
+        if (p >= xs[n - 1]) return ys[n - 1];
+        var k: usize = 1;
+        while (k < n - 1 and p > xs[k]) k += 1;
+        const t = (p - xs[k - 1]) / (xs[k] - xs[k - 1]);
+        return ys[k - 1] + t * (ys[k] - ys[k - 1]);
+    }
+
+    /// Line `which` (0 c, 1 stop2, 2 deep_p, 3 deep_base) for a greedy (0) or sampled (1) chain: knob word, else the file's, else `stock`.
+    pub fn line(c: *const GCal, mode: usize, which: usize, stock: f64) f64 {
+        const words = [4][]const u8{ "gcal_c", "gcal_stop2", "gcal_deep_p", "gcal_deep_base" };
+        if (q38KnobFile(words[which])) |v| return if (which == 3) @as(f64, @floatFromInt(v)) else @as(f64, @floatFromInt(v)) / 1000.0;
+        const v = c.thr[mode][which];
+        return if (v >= 0) v else stock;
+    }
+};
+var gcal_state: i8 = -1;
+var gcal_table: GCal = .{};
+pub fn q38GCal() ?*const GCal {
+    if (gcal_state < 0) {
+        gcal_state = 0;
+        if (std.c.getenv("TF_FLASHNEXT_Q38_GCAL")) |path| {
+            var buf: [8192]u8 = undefined;
+            var len: usize = 0;
+            const fd = std.c.open(path, .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, @as(std.c.mode_t, 0));
+            if (fd >= 0) {
+                const got = std.c.pread(fd, &buf, buf.len, 0);
+                if (got > 0) len = @intCast(got);
+                _ = std.c.close(fd);
+            }
+            var ok = false;
+            var lines = std.mem.tokenizeScalar(u8, buf[0..len], '\n');
+            while (lines.next()) |ln| {
+                var it = std.mem.tokenizeAny(u8, ln, " \t\r");
+                const name = it.next() orelse continue;
+                if (std.mem.eql(u8, name, "set")) {
+                    const key = it.next() orelse continue;
+                    const val = std.fmt.parseFloat(f64, it.next() orelse continue) catch continue;
+                    const keys = [8][]const u8{ "c_g", "stop2_g", "deep_p_g", "deep_base_g", "c_s", "stop2_s", "deep_p_s", "deep_base_s" };
+                    for (keys, 0..) |k, i| if (std.mem.eql(u8, key, k)) {
+                        gcal_table.thr[i / 4][i % 4] = val;
+                    };
+                    continue;
+                }
+                const kind: usize = if (std.mem.eql(u8, name, "g")) 0 else if (std.mem.eql(u8, name, "st")) 1 else if (std.mem.eql(u8, name, "sn")) 2 else continue;
+                var n: usize = 0;
+                while (it.next()) |w| {
+                    if (n == GCal.max_knots) break;
+                    const colon = std.mem.indexOfScalar(u8, w, ':') orelse continue;
+                    const xv = std.fmt.parseFloat(f64, w[0..colon]) catch continue;
+                    const yv = std.fmt.parseFloat(f64, w[colon + 1 ..]) catch continue;
+                    if (n > 0 and !(xv > gcal_table.x[kind][n - 1])) continue;
+                    if (!(yv >= 0 and yv <= 1)) continue;
+                    gcal_table.x[kind][n] = xv;
+                    gcal_table.y[kind][n] = yv;
+                    n += 1;
+                }
+                if (n >= 2) {
+                    gcal_table.n[kind] = n;
+                    ok = true;
+                }
+            }
+            if (ok) gcal_state = 1;
+            std.debug.print("q38 gcal: {s} knots g {d} st {d} sn {d}\n", .{ if (ok) "on" else "no table read", gcal_table.n[0], gcal_table.n[1], gcal_table.n[2] });
+        }
+    }
+    if (gcal_state != 1) return null;
+    if (q38KnobFile("gcal")) |v| if (v == 0) return null;
+    return &gcal_table;
+}
