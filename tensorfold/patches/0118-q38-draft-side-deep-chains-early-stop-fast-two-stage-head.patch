+// ---- q38 HEAD2 round 9 (TF_FLASHNEXT_Q38_HEAD2_FAST): the preview's arithmetic in integers. Drafts only.
+// fn_q38_head2_scan2 = fn_q38_head2_scan for R = 512 with the rotated input row as int8 (one scale a group of 32 values) and a lane's
+// 16 code x input products as four dp4a (a row was 16 shift / mask / convert / multiply-add steps a lane). The preview's scores differ
+// from fn_q38_head2_scan's by the input's rounding (under 0.4 % of a group's largest value); the 4-bit rows re-score its best rows.
+static __device__ __forceinline__ int q38_dp4a(int a, int b, int c) {
+    int r;
+    asm volatile("dp4a.s32.s32 %0, %1, %2, %3;" : "=r"(r) : "r"(a), "r"(b), "r"(c));
+    return r;
+}
+
+extern "C" __global__ void __launch_bounds__(1024) fn_q38_head2_scan2(const unsigned char* __restrict__ P, const __nv_bfloat16* __restrict__ S,
+                                                                      const __nv_bfloat16* __restrict__ B, const float* __restrict__ xr,
+                                                                      __nv_bfloat16* __restrict__ out, int V, int R, int* __restrict__ cidx,
+                                                                      float* __restrict__ tails) {
+    using namespace fn_mtp;
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    __shared__ float sx[512];
+    __shared__ float sg[16];
+    __shared__ float sq[16];
+    __shared__ signed char s8[512];
+    __shared__ float sv[256];
+    if (t < 512) sx[t] = xr[t];
+    __syncthreads();
+    if (t < 16) {
+        float a = 0.0f, m = 0.0f;
+#pragma unroll
+        for (int j = 0; j < 32; ++j) {
+            const float x = sx[t * 32 + j];
+            a += x;
+            m = fmaxf(m, fabsf(x));
+        }
+        sg[t] = a;
+        sq[t] = m > 0.0f ? m / 127.0f : 0.0f;
+    }
+    __syncthreads();
+    if (t < 512) {
+        const float q = sq[t >> 5];
+        s8[t] = q > 0.0f ? static_cast<signed char>(__float2int_rn(sx[t] / q)) : static_cast<signed char>(0);
+    }
+    __syncthreads();
+    const int g = lane >> 1;
+    const bool first = (lane & 1) == 0;
+    // the lane's 16 input values as four words: values 0,2,4,6 | 8,10,12,14 | 1,3,5,7 | 9,11,13,15 (a byte a value)
+    const signed char* xs = s8 + lane * 16;
+    int w4[4];
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+        const int o = (k & 1) * 8 + (k >> 1);
+        w4[k] = (static_cast<int>(xs[o]) & 255) | ((static_cast<int>(xs[o + 2]) & 255) << 8) | ((static_cast<int>(xs[o + 4]) & 255) << 16) | ((static_cast<int>(xs[o + 6]) & 255) << 24);
+    }
+    const float xq = sq[g];
+    const float sgg = sg[g];
+    const int v0 = blockIdx.x * 256 + warp * 8;
+    unsigned long long q[8];
+    float sc[8], bi[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const int v = v0 + i;
+        const bool in = v < V;
+        q[i] = in ? *reinterpret_cast<const unsigned long long*>(P + static_cast<long long>(v) * 256 + lane * 8) : 0ull;
+        sc[i] = in ? __bfloat162float(S[static_cast<long long>(v) * 16 + g]) : 0.0f;
+        bi[i] = (in && first) ? __bfloat162float(B[static_cast<long long>(v) * 16 + g]) : 0.0f;
+    }
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+        const int v = v0 + i;
+        float sum = -CUDART_INF_F;
+        if (v < V) {
+            const unsigned long long e = q[i] & 0x0f0f0f0f0f0f0f0full, o = (q[i] >> 4) & 0x0f0f0f0f0f0f0f0full;
+            int d = q38_dp4a(static_cast<int>(e), w4[0], 0);
+            d = q38_dp4a(static_cast<int>(e >> 32), w4[1], d);
+            d = q38_dp4a(static_cast<int>(o), w4[2], d);
+            d = q38_dp4a(static_cast<int>(o >> 32), w4[3], d);
+            sum = sc[i] * xq * static_cast<float>(d) + bi[i] * sgg;
+            for (int w = 16; w; w >>= 1) sum += __shfl_xor_sync(0xffffffffu, sum, w);
+            if (lane == 0) out[v] = __float2bfloat16(sum);
+        }
+        if (lane == 0) sv[warp * 8 + i] = sum;
+    }
+    __syncthreads();
+    if (warp != 0) return;
+    float b1 = -CUDART_INF_F;
+    int i1 = 0x7fffffff;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) better(b1, i1, sv[lane * 8 + j], lane * 8 + j);
+    for (int o = 16; o; o >>= 1) better(b1, i1, __shfl_xor_sync(0xffffffffu, b1, o), __shfl_xor_sync(0xffffffffu, i1, o));
+    float b2 = -CUDART_INF_F;
+    int i2 = 0x7fffffff;
+#pragma unroll
+    for (int j = 0; j < 8; ++j)
+        if (lane * 8 + j != i1) better(b2, i2, sv[lane * 8 + j], lane * 8 + j);
+    for (int o = 16; o; o >>= 1) better(b2, i2, __shfl_xor_sync(0xffffffffu, b2, o), __shfl_xor_sync(0xffffffffu, i2, o));
+    float b3 = -CUDART_INF_F;
+    int i3 = 0x7fffffff;
+#pragma unroll
+    for (int j = 0; j < 8; ++j)
+        if (lane * 8 + j != i1 && lane * 8 + j != i2) better(b3, i3, sv[lane * 8 + j], lane * 8 + j);
+    for (int o = 16; o; o >>= 1) better(b3, i3, __shfl_xor_sync(0xffffffffu, b3, o), __shfl_xor_sync(0xffffffffu, i3, o));
+    float rest = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        const int k = lane * 8 + j;
+        if (k != i1 && k != i2 && k != i3 && sv[k] > -CUDART_INF_F) rest += expf(sv[k] - b1);
+    }
+    for (int o = 16; o; o >>= 1) rest += __shfl_xor_sync(0xffffffffu, rest, o);
+    if (lane == 0) {
+        const int base = blockIdx.x * 256;
+        cidx[3 * blockIdx.x] = b1 > -CUDART_INF_F ? base + i1 : -1;
+        cidx[3 * blockIdx.x + 1] = b2 > -CUDART_INF_F ? base + i2 : -1;
+        cidx[3 * blockIdx.x + 2] = b3 > -CUDART_INF_F ? base + i3 : -1;
+        tails[blockIdx.x] = rest > 0.0f ? b1 + logf(rest) : -CUDART_INF_F;
+    }
+}
+
+// fn_q38_head2_rot with the rotation as bf16 (half the bytes a chain step).
+extern "C" __global__ void __launch_bounds__(256) fn_q38_head2_rot2(const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ At,
+                                                                     float* __restrict__ xr, int D) {
+    const int o = blockIdx.x, t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const __nv_bfloat16* a = At + static_cast<long long>(o) * D;
+    float sum = 0.0f;
+    for (int i = t; i < D; i += blockDim.x) sum += __bfloat162float(a[i]) * __bfloat162float(x[i]);
+    for (int w = 16; w; w >>= 1) sum += __shfl_xor_sync(0xffffffffu, sum, w);
+    __shared__ float ss[8];
+    if (lane == 0) ss[warp] = sum;
+    __syncthreads();
+    if (t == 0) {
+        float all = 0.0f;
+        for (int w = 0; w < static_cast<int>(blockDim.x >> 5); ++w) all += ss[w];
+        xr[o] = all;
+    }
+}
