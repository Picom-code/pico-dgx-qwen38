+/// TF_FLASHNEXT_Q38_STOP2=x (q38; default 0 = off; 0.5 measured): a lone chain under the product rule (TF_FLASHNEXT_CONFIDENCE < 0) does
+/// not compute its next step once the running product of the proposed drafts is below x: that step's draft would cross the gate more
+/// often than not, and a step that crosses is computed and thrown away. Drafts only: fewer are proposed, every token is still verified.
+pub fn q38Stop2() f64 {
+    const st = struct {
+        var c: f64 = -1;
+    };
+    if (st.c < 0) {
+        st.c = 0;
+        if (std.c.getenv("TF_FLASHNEXT_Q38_STOP2")) |v| st.c = std.fmt.parseFloat(f64, std.mem.span(v)) catch 0;
+        if (!(st.c >= 0 and st.c <= 1.0)) st.c = 0;
+    }
+    return st.c;
+}
+
+/// TF_FLASHNEXT_Q38_HEAD2_FAST=N (q38; default 0; bits): 1 = the two-stage head's preview (block form) in integers (fn_q38_head2_scan2:
+/// the rotated input as int8, dp4a); 2 = the rotation as bf16 (fn_q38_head2_rot2). 3 = both. Drafts only.
+pub fn q38Head2Fast() u32 {
+    const v = std.c.getenv("TF_FLASHNEXT_Q38_HEAD2_FAST") orelse return 0;
+    return (std.fmt.parseInt(u32, std.mem.span(v), 10) catch 0) & 3;
+}
+
+/// TF_FLASHNEXT_Q38_DEEP=P[,BASE] (q38; default off; BASE default 6): with TF_FLASHNEXT_DRAFTS above BASE, a lone chain goes past BASE
+/// drafts only while the running product of its drafts is at least P (the product rule, TF_FLASHNEXT_CONFIDENCE < 0); chains of a
+/// shared round stay at BASE. Drafts only: every token is still verified.
+pub const Deep = struct { p: f64 = 0, base: usize = 6 };
+pub fn q38Deep() Deep {
+    const st = struct {
+        var done: bool = false;
+        var d: Deep = .{};
+    };
+    if (!st.done) {
+        st.done = true;
+        if (std.c.getenv("TF_FLASHNEXT_Q38_DEEP")) |v| {
+            var it = std.mem.splitScalar(u8, std.mem.span(v), ',');
+            const p = std.fmt.parseFloat(f64, it.first()) catch 0;
+            const base = if (it.next()) |b| std.fmt.parseInt(usize, b, 10) catch 6 else 6;
+            if (p > 0 and p <= 1.0 and base >= 1) st.d = .{ .p = p, .base = base };
+        }
+    }
+    return st.d;
+}
+
+/// TF_FLASHNEXT_Q38_HEAD2_SAMPLED=1 (q38; default off): a lone SAMPLED chain also drafts with the two-stage head (block form): its
+/// keyed draw takes its candidates from the row of preview scores with the re-scored rows' 4-bit scores in place. Drafts only: the
+/// main model's own keyed draw at each position decides, so a seeded request's text does not change.
+pub fn q38Head2Sampled() bool {
+    const st = struct {
+        var c: i32 = -1;
+    };
+    if (st.c < 0) st.c = if (std.c.getenv("TF_FLASHNEXT_Q38_HEAD2_SAMPLED")) |v| @intFromBool(v[0] == '1') else 0;
+    return st.c == 1;
+}
