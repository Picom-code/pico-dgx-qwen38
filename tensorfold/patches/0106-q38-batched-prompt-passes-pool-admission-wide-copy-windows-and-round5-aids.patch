index 0000000..32b4c68
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_lanes_many.zig
@@ -0,0 +1,54 @@
+//! q38: several waiting streams' prompts in one prompt pass (the lane backend's prefill_many; TF_FLASHNEXT_Q38_PREFILL_MANY).
+const std = @import("std");
+const lanes = @import("lanes");
+const knobs = @import("cuda_knobs.zig");
+const batch_state = @import("cuda_batch_state.zig");
+
+pub const max_together = 16;
+const small_prefix = 16;
+
+/// True: every stream's prompt is in, each left as its own pass leaves it. False (nothing touched): they go one by one.
+pub fn prefillMany(self: anytype, ss: []const *lanes.Stream) !bool {
+    const limit = knobs.manyRows();
+    if (limit == 0 or self.ranks != null or self.head == null or ss.len < 2 or ss.len > max_together) return false;
+    var total: usize = 0;
+    for (ss) |s| {
+        const n = s.prompt().len;
+        if (!s.drafts or s.images.len != 0 or s.untaught) return refused("a stream has no drafts, images or is untaught", 0);
+        // a kept prefix of a few tokens (a chat template's opening) is not restored: the prompt runs from its first token
+        if (s.reuse.saved != null and s.reuse.at > small_prefix) return refused("a stream resumes a kept prefix", s.reuse.at);
+        if (n == 0 or n > limit or n > batch_state.att_rows or n + s.max_new > self.context) return refused("a prompt is too long", n);
+        total += n;
+    }
+    if (total > self.engine.chunk) return refused("too many rows", total);
+    for (ss) |s| s.reuse.saved = null; // the host reports the kept state untouched (its entry is released, not consumed)
+    const t0 = std.Io.Clock.awake.now(self.engine.io).toNanoseconds();
+    var seqs: [max_together]*@import("cuda_prompt.zig").Seq = undefined;
+    var ds: [max_together]*@import("cuda_mtp.zig").Draft = undefined;
+    var idss: [max_together][]const u32 = undefined;
+    var ats: [max_together]usize = undefined;
+    var stops: [max_together]usize = undefined;
+    // every stream's caches first: opening one may move the lane table, so the pointers are taken after the last
+    for (ss) |s| _ = try self.open(s);
+    for (ss, 0..) |s, i| {
+        const l = try self.lane(s);
+        if (l.filled == null or l.filled.? != 0 or l.draft == null) return error.PositionMismatch;
+        seqs[i] = &l.seq;
+        ds[i] = &l.draft.?;
+        idss[i] = s.prompt();
+        ats[i] = 0;
+        stops[i] = idss[i].len;
+    }
+    const n = ss.len;
+    try self.ops().prefillChunkMany(seqs[0..n], ds[0..n], idss[0..n], ats[0..n], stops[0..n], self.logits.ptr);
+    for (ss) |s| (try self.lane(s)).filled = null;
+    std.debug.print("q38 many: {d} prompts, {d} rows in one pass, {d:.1} ms\n", .{ n, total, @as(f64, @floatFromInt(std.Io.Clock.awake.now(self.engine.io).toNanoseconds() - t0)) / 1e6 });
+    return true;
+}
+
+var refusals: u32 = 0;
+fn refused(why: []const u8, n: usize) bool {
+    refusals += 1;
+    if (refusals <= 20) std.debug.print("q38 many: not batched ({s}; {d})\n", .{ why, n });
+    return false;
+}
