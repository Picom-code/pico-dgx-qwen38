+fn q38TakeHost(gpa: std.mem.Allocator, len: usize) ![]u16 {
+    if (@import("cuda_knobs.zig").q38LaneReuse() > 0) for (&q38_hosts) |*slot| if (slot.*) |h| {
+        if (h.len != len) continue;
+        slot.* = null;
+        return h;
+    };
+    return gpa.alloc(u16, len);
