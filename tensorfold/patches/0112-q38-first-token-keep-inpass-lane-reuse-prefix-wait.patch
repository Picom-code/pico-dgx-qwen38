+
+fn q38Give(b: *cuda.DeviceBuffer) void {
+    const sets = @import("cuda_knobs.zig").q38LaneReuse();
+    if (sets > 0 and q38_pool_bytes + b.len <= sets * q38_set_bytes) for (&q38_pool) |*slot| if (slot.* == null) {
