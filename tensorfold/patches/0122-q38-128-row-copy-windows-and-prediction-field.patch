+/// q38 round 10: OpenAI's `prediction` field ({"type": "content", "content": "..." or [{"type": "text", "text": "..."}]}) as token ids,
+/// parts separated by 0xFFFF_FFFF. The text is only a source of drafts (every drafted token is kept only if it equals the model's own),
+/// so a wrong or malformed prediction changes speed, never the reply: a shape that is not understood is ignored, not refused.
+/// TF_Q38_PREDICTION=0 ignores the field; TF_Q38_PRED_MAX caps its tokens (default 65536).
+fn predictionIds(srv: *Server, cx: *Cx, field: ?Value) Failure![]const u32 {
+    const p = field orelse return &.{};
+    if (std.c.getenv("TF_Q38_PREDICTION")) |v| if (v[0] == '0') return &.{};
+    var most: usize = 65536;
+    if (std.c.getenv("TF_Q38_PRED_MAX")) |v| most = std.fmt.parseInt(usize, std.mem.span(v), 10) catch most;
+    const content: Value = if (p == .object) (p.get("content") orelse return &.{}) else p;
+    var out: std.ArrayList(u32) = .empty;
+    const one = [_]Value{content};
+    const parts: []const Value = if (content == .array) content.array else if (content == .string) &one else return &.{};
+    for (parts) |part| {
+        const text: []const u8 = switch (part) {
+            .string => |t| t,
+            .object => if (part.get("text")) |t| (if (t == .string) t.string else continue) else continue,
+            else => continue,
+        };
+        if (text.len == 0) continue;
+        const part_ids = srv.text.encode(cx.a, text, false) catch |e| switch (e) {
+            error.OutOfMemory => return error.OutOfMemory,
+            else => continue,
+        };
+        if (out.items.len + part_ids.len + 1 > most) break;
+        if (out.items.len > 0) try out.append(cx.a, 0xFFFF_FFFF);
+        try out.appendSlice(cx.a, part_ids);
+    }
+    return out.items;
+}
