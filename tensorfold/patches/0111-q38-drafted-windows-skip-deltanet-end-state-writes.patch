+var late_skip_cache: usize = std.math.maxInt(usize);
+/// TF_FLASHNEXT_Q38_LATE_SKIP=T (q38; default 0: off; at most 32; needs TF_FLASHNEXT_KEEP_LATE): a drafted window whose rows plus the rows
+/// already waiting in the lane's DeltaNet log are at most T does not write its end states (36 layers x 3.1 MB a stream and pass).
+/// Kept whole, its rows wait in the log like a partly kept window's, and the next window's chain takes them first: the same steps in
+/// the same order on the same start state, so the same bits. Above T the pass writes the end states as before.
+pub fn q38LateSkip() usize {
+    if (late_skip_cache != std.math.maxInt(usize)) return late_skip_cache;
+    var t: usize = 0;
+    if (std.c.getenv("TF_FLASHNEXT_Q38_LATE_SKIP")) |v| t = std.fmt.parseInt(usize, std.mem.span(v), 10) catch 0;
+    late_skip_cache = @min(t, 32);
+    return late_skip_cache;
+}
