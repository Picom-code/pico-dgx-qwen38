+/// TF_FLASHNEXT_Q38_QMMF_ST=N (q38, off unless set): cp.async stages of the 16-row MXFP8 / BF16 lane tiles (stock 4); TF_FLASHNEXT_Q38_QMMF_ST_CL=N
+/// overrides it for the cluster (K-sliced) instances. Only the pipeline depth changes: each block's mma sequence, and so its bits, are the same.
+fn q38Stages(cluster: bool) u32 {
+    const st = struct {
+        var v: [2]u32 = .{ 0, 0 };
+    };
+    if (st.v[0] == 0) {
+        st.v[0] = 4;
+        if (std.c.getenv("TF_FLASHNEXT_Q38_QMMF_ST")) |e| st.v[0] = std.fmt.parseInt(u32, std.mem.span(e), 10) catch 4;
+        st.v[1] = st.v[0];
+        if (std.c.getenv("TF_FLASHNEXT_Q38_QMMF_ST_CL")) |e| st.v[1] = std.fmt.parseInt(u32, std.mem.span(e), 10) catch st.v[0];
+    }
+    return st.v[@intFromBool(cluster)];
+}
+
+/// sharedBytes with the q38 stage count of a 16-row MXFP8 / BF16 tile.
+pub fn sharedBytesQ(mode: Mode, bm: u32, cluster: bool) u32 {
+    if (bm != 16 or (mode != .mxfp8 and mode != .bf16)) return sharedBytes(mode, bm);
+    const w: u32 = if (mode == .bf16) bn * group * 2 else bn * group;
+    const s: u32 = if (mode == .mxfp8) bn * 2 else 0;
+    const stage = (bm * group * 2 + w + s + 127) / 128 * 128;
+    const partials = (bm / 16) * 2 * 4 * threads * 4;
+    return @max(q38Stages(cluster) * stage, partials);
+}
