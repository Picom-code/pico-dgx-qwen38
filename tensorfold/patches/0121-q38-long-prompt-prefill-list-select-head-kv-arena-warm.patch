diff --git a/zig/src/families/flashnext/cuda_q38_arena.zig b/zig/src/families/flashnext/cuda_q38_arena.zig
new file mode 100644
index 0000000..4d4222f
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_q38_arena.zig
@@ -0,0 +1,169 @@
+//! q38 device arena (TF_FLASHNEXT_Q38_ARENA=1; needs the elastic prompt cache). On a GB10 a device allocation costs about
+//! 0.1-0.15 ms a MiB (the pages come from the system at the call), and every request pays it: its sequence caches at lane open
+//! (174 ms at a 110K-token prompt), the draft head's caches, and each kept prompt state (270 ms at 110K). With the flag the room the
+//! start-up plan already gives the lanes and the prompt cache is taken ONCE, after the weights have loaded, as one device
+//! allocation, and DeviceBuffer.alloc is served from it through memory.zig's hook: best fit over a free list sorted by address,
+//! ranges given back are merged with their neighbours. A range is zero-filled when it is handed out (fresh driver memory reads as
+//! zeros; nothing may come to depend on what an earlier owner left). A request the arena cannot place (too small to bother, no
+//! gap large enough) goes to cuMemAlloc as before. Only addresses change: no kernel, no operand, no order.
+const std = @import("std");
+const cuda = @import("cuda");
+
+const Range = struct { at: u64, len: u64 };
+/// Smaller requests stay with the driver (its own small-block path is quick).
+const min_len: usize = 64 << 10;
+const alignment: u64 = 4096;
+
+pub const Stats = struct { served: u64 = 0, refused: u64 = 0, fallback: u64 = 0, live: u64 = 0, peak: u64 = 0, largest_miss: u64 = 0 };
+
+var base: u64 = 0;
+var size: u64 = 0;
+var gpa_: std.mem.Allocator = undefined;
+var drv: ?*const cuda.Driver = null;
+var free_list: std.ArrayList(Range) = .empty; // sorted by address, neighbours never touch
+var live: std.AutoHashMapUnmanaged(u64, u64) = .empty; // address -> rounded length
+var mutex: std.atomic.Mutex = .unlocked;
+var st: Stats = .{};
+var zero: bool = true;
+var raw_next: bool = false;
+
+/// A kept prompt state writes every byte of its buffer before anything reads it (cuda_snap.zig), so its range needs no zero fill:
+/// `raw(true)` before that one allocation, `raw(false)` after it (the engine thread makes both calls and the allocation).
+pub fn raw(v: bool) void {
+    raw_next = v;
+}
+
+fn lock() void {
+    while (!mutex.tryLock()) std.Thread.yield() catch {};
+}
+
+/// TF_FLASHNEXT_Q38_ARENA: 0 / unset off; 1 on (ranges zero-filled when handed out); 2 on without the zero fill (experiment only).
+pub fn mode() u8 {
+    const s = struct {
+        var v: i8 = -1;
+    };
+    if (s.v < 0) s.v = if (std.c.getenv("TF_FLASHNEXT_Q38_ARENA")) |e| (if (e[0] == '1') @as(i8, 1) else if (e[0] == '2') @as(i8, 2) else 0) else 0;
+    return @intCast(s.v);
+}
+
+/// Takes `bytes` of device memory once and serves later DeviceBuffer.alloc calls from it. Called once, at start-up, after the
+/// weights and the engine's fixed buffers exist. A failure leaves the engine as it was (every request to cuMemAlloc).
+pub fn install(gpa: std.mem.Allocator, d: *const cuda.Driver, bytes: u64) void {
+    if (drv != null or mode() == 0 or bytes < (64 << 20)) return;
+    if (cuda.memory.currentHook() != null) {
+        std.debug.print("q38 arena: another device sub-allocator is installed; off\n", .{});
+        return;
+    }
+    const n = std.mem.alignForward(u64, bytes, 2 << 20);
+    var p: u64 = 0;
+    if (d.api.cuMemAlloc_v2(&p, n) != 0 or p == 0) {
+        std.debug.print("q38 arena: {d} MiB could not be taken; off\n", .{n >> 20});
+        return;
+    }
+    free_list.append(gpa, .{ .at = p, .len = n }) catch {
+        _ = d.api.cuMemFree_v2(p);
+        return;
+    };
+    gpa_ = gpa;
+    base = p;
+    size = n;
+    zero = mode() == 1;
+    drv = d;
+    cuda.memory.setHook(.{ .ctx = @ptrCast(&st), .alloc = hookAlloc, .free = hookFree });
+    std.debug.print("q38 arena: {d} MiB of device memory taken once; sequence caches, draft caches and kept prompt states are placed in it{s}\n", .{ n >> 20, if (zero) "" else " (no zero fill)" });
+}
+
+pub fn stats() Stats {
+    lock();
+    defer mutex.unlock();
+    return st;
+}
+
+pub fn on() bool {
+    return drv != null;
+}
+
+/// Whether a range of `len` bytes can be placed now. A kept prompt state is only ever placed in the arena (cuda_snap.zig): a
+/// state that fell back to cuMemAlloc would sit on top of the arena's fixed bytes, outside the start-up plan (measured: five
+/// 1.1 GiB states of a 5-agent run fell back and the box was left with 2 GiB). The prompt cache evicts until a state fits.
+pub fn fits(len: usize) bool {
+    if (drv == null) return true;
+    const n = std.mem.alignForward(u64, len, alignment);
+    lock();
+    defer mutex.unlock();
+    for (free_list.items) |r| if (r.len >= n) return true;
+    st.refused += 1;
+    return false;
+}
+
+fn hookAlloc(_: *anyopaque, len: usize) ?u64 {
+    const d = drv orelse return null;
+    if (len < min_len) return null;
+    const n = std.mem.alignForward(u64, len, alignment);
+    lock();
+    var best: ?usize = null;
+    for (free_list.items, 0..) |r, i| {
+        if (r.len < n) continue;
+        if (best == null or r.len < free_list.items[best.?].len) best = i;
+    }
+    const i = best orelse {
+        st.fallback += 1;
+        st.largest_miss = @max(st.largest_miss, n);
+        mutex.unlock();
+        return null;
+    };
+    const at = free_list.items[i].at;
+    live.put(gpa_, at, n) catch {
+        st.fallback += 1;
+        mutex.unlock();
+        return null;
+    };
+    if (free_list.items[i].len == n) {
+        _ = free_list.orderedRemove(i);
+    } else {
+        free_list.items[i].at += n;
+        free_list.items[i].len -= n;
+    }
+    st.served += 1;
+    st.live += n;
+    st.peak = @max(st.peak, st.live);
+    mutex.unlock();
+    if (zero and !raw_next) {
+        if (d.api.cuMemsetD8_v2(at, 0, n) != 0) {
+            // the range cannot be proved clean: it goes back and the driver serves the request
+            _ = hookFree(@ptrCast(&st), at);
+            lock();
+            st.served -= 1;
+            st.fallback += 1;
+            mutex.unlock();
+            return null;
+        }
+    }
+    return at;
+}
+
+fn hookFree(_: *anyopaque, p: u64) bool {
+    lock();
+    defer mutex.unlock();
+    const e = live.fetchRemove(p) orelse return false;
+    const n = e.value;
+    st.live -= n;
+    // the place among the free ranges (sorted by address)
+    var i: usize = 0;
+    while (i < free_list.items.len and free_list.items[i].at < p) i += 1;
+    const joins_prev = i > 0 and free_list.items[i - 1].at + free_list.items[i - 1].len == p;
+    const joins_next = i < free_list.items.len and p + n == free_list.items[i].at;
+    if (joins_prev and joins_next) {
+        free_list.items[i - 1].len += n + free_list.items[i].len;
+        _ = free_list.orderedRemove(i);
+    } else if (joins_prev) {
+        free_list.items[i - 1].len += n;
+    } else if (joins_next) {
+        free_list.items[i].at = p;
+        free_list.items[i].len += n;
+    } else {
+        // a list that cannot grow leaks the range inside the arena (still ours; never handed out again)
+        free_list.insert(gpa_, i, .{ .at = p, .len = n }) catch {};
+    }
+    return true;
+}
