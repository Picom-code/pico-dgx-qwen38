+    for (int t = 0; t < 2; ++t)
+#pragma unroll
+        for (int ks = 0; ks < 8; ++ks) {
+            a[t][ks][0] = qw[(2 * t) * 64 + ks * 8 + cw];
+            a[t][ks][1] = qw[(2 * t + 1) * 64 + ks * 8 + cw];
+            a[t][ks][2] = qw[(2 * t) * 64 + ks * 8 + 4 + cw];
+            a[t][ks][3] = qw[(2 * t + 1) * 64 + ks * 8 + 4 + cw];
