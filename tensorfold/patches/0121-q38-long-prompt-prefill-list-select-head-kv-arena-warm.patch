+// ---- the listed cut (TF_FLASHNEXT_Q38_QSA_LIST) ----
+// fn_q38_qsa_select_cert16 passes over a row's halves four times (two radix passes for v, then the classification and the
+// placement, each with a block-wide barrier every 1,024 blocks), and at 200K tokens of context a row is 100 KB. Here:
+//   1 one pass: a histogram of the row's keys by their top 12 bits (4,096 bins, each 1.6 % wide in value). It names the bin d of the
+//     top-th largest key and the exact number nl of keys from bin d - 1 up;
+//   2 if top <= nl <= LCAP, one pass WITHOUT barriers writes every block whose key is >= tlo (the lower edge of bin d - 1) to a
+//     list in shared memory (a warp reserves its entries with one atomic add; the list is in no particular order);
+//   3 the top-th largest key of the ROW is the top-th largest of the list (every block left out is below tlo, hence below every
+//     listed one): the same v as the radix passes find;
+//   4 a block left out has f <= half(tlo), so f + |f| C + e0 <= tlo's upper end (x + |x| C grows with x); when that end is below
+//     v's lower end every block left out is certainly not selected. The listed blocks are classified as in the 16-bit kernel; the
+//     in-between ones get the exact sum (the scalar kernel's bits) and are ranked exactly, ties to the lowest BLOCK (the stock rule);
+//   5 the selected blocks set their bits in a bitmap over the row's blocks, and a prefix count over the bitmap writes them in
+//     block order.
+// Anything else (a non-finite half, a list too long, more than 65,536 blocks, tlo too close to v, too many in-between blocks, a
+// placement that does not come out at `top`) leaves the row untouched and the four-pass body runs: the lists are the same.
+// STATS [10] rows that took the listed path, [11] rows it gave up on.
+namespace q38cert {
+constexpr int LCAP = 2560, HB = 4096, BMW = 2048;
+
+// The rank-th largest (rank >= 1) of the 16-bit keys key[0, n) in shared memory: two 8-bit radix passes.
+__device__ __forceinline__ uint32_t kth16(const unsigned short* key, int n, int rank, int* hist, uint32_t* cut_s, int* need_s) {
+    uint32_t cut = 0;
+    int need = rank;
+    for (int p = 0; p < 2; ++p) {
+        const int shift = 8 - 8 * p;
+        for (int i = threadIdx.x; i < 256; i += blockDim.x) hist[i] = 0;
+        __syncthreads();
+        for (int b = threadIdx.x; b < n; b += blockDim.x) {
+            const uint32_t k = key[b];
+            if (p == 0 || (k >> 8) == (cut >> 8)) atomicAdd(&hist[(k >> shift) & 0xFF], 1);
+        }
+        __syncthreads();
+        if (threadIdx.x == 0) {
+            int above = 0;
+            int d = 255;
+            for (; d > 0; --d) {
+                if (above + hist[d] >= need) break;
+                above += hist[d];
+            }
+            *need_s = need - above;
+            *cut_s = cut | (static_cast<uint32_t>(d) << shift);
+        }
+        __syncthreads();
+        cut = *cut_s;
+        need = *need_s;
+        __syncthreads();
+    }
+    return cut;
+}
