+/// TF_FLASHNEXT_Q38_SCRATCH_TRIM=N (q38; default 0: off; the recipe value is 3072 = the default chunk): the pass scratch of a
+/// chunk wider than N rows keeps its K-slice partials (hc_part, part, ple_part: one slice a row past N; native_part: none past N)
+/// only for N rows, and head_local (one byte a vocabulary entry a row, written by the two-rank head and by the draft head's
+/// lanes only) for 256 rows. No kernel and no value changes: these are bytes no launch of a pass wider than N rows touches
+/// (slices are folded in the block from 64 rows; the native lane reduces in a cluster or in the block from 256 rows); the users
+/// that could are guarded (error.UnexpectedTensor) instead of writing past a buffer. Values under 256 count as 256.
+var scratch_trim_cache: i64 = -1;
+pub fn q38ScratchTrim() usize {
+    if (scratch_trim_cache < 0) {
+        const v: i64 = if (std.c.getenv("TF_FLASHNEXT_Q38_SCRATCH_TRIM")) |e| (std.fmt.parseInt(i64, std.mem.span(e), 10) catch 0) else 0;
+        scratch_trim_cache = if (v <= 0) 0 else @max(v, 256);
+        if (v > 0) std.debug.print("q38 scratch trim: slices kept for {d} rows, head_local for 256{s}\n", .{ scratch_trim_cache, if (q38ScratchCheck()) " (check mode: guard words after every trimmed buffer)" else "" });
+    }
+    return @intCast(scratch_trim_cache);
+}
+/// TF_FLASHNEXT_Q38_HC_DN_TALL=N (q38; default 0: off; the recipe value is 3072): prompt passes of at least N rows take the 64-row
+/// tile of the fused read-out's down projection (fn_hcn_down4). The stock rule (cuda_tiles.zig pickDown) prices a wave of CTAs in
+/// proportion to the tile's height and so takes the 32-row tile for e.g. 8,192 rows; measured, a 64-row wave costs 1.53x a 32-row
+/// one, and the 64-row tile is 24 % faster a row there. Every tile writes the same bytes (the kernels differ only in rows a CTA).
+var hc_dn_tall_cache: i64 = -1;
+pub fn q38HcDnTall() usize {
+    if (hc_dn_tall_cache < 0) {
+        const v: i64 = if (std.c.getenv("TF_FLASHNEXT_Q38_HC_DN_TALL")) |e| (std.fmt.parseInt(i64, std.mem.span(e), 10) catch 0) else 0;
+        hc_dn_tall_cache = @max(v, 0);
+        if (v > 0) std.debug.print("q38 hc down: the 64-row tile from {d} rows{s}\n", .{ v, if (q38HcDnTallCheck()) " (check mode: the stock tile runs too)" else "" });
+    }
+    return @intCast(hc_dn_tall_cache);
+}
+/// TF_FLASHNEXT_Q38_HC_DN_TALL_CHECK=1: where the flag changes the tile, the stock tile runs first into scratch and every word of
+/// the two outputs is compared on the device ("q38 hcdn tall check ... diff=" every 96 launches).
+var hc_dn_tall_check_cache: i32 = -1;
+pub fn q38HcDnTallCheck() bool {
+    if (hc_dn_tall_check_cache < 0) hc_dn_tall_check_cache = if (std.c.getenv("TF_FLASHNEXT_Q38_HC_DN_TALL_CHECK")) |v| @intFromBool(v[0] == '1') else 0;
+    return hc_dn_tall_check_cache == 1;
+}
+
+/// TF_FLASHNEXT_Q38_SCRATCH_CHECK=1: every trimmed buffer gets 4,096 guard bytes behind it; each pass reads them back (it waits
