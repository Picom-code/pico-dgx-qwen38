+/// TF_FLASHNEXT_Q38_QDUMP=FILE (q38 measuring aid, off unless set): the key lists of fused prompt attention launches: after
+/// TF_FLASHNEXT_Q38_QDUMP_SKIP launches (default 0) every TF_FLASHNEXT_Q38_QDUMP_STEP-th (default 1), at most TF_FLASHNEXT_Q38_QDUMP_MAX
+/// (default 6). Record: u32 magic 0x51444D50, rows, idw, first position, then nk [rows] i32, sparse [rows] i32, ids [rows][idw] i32.
+/// It waits for the stream; values never change.
+pub const Qdump = struct {
+    var state: i8 = -1;
+    var fd: c_int = -1;
+    var left: usize = 6;
+    var skip: usize = 0;
+    var step: usize = 1;
+    var seen: usize = 0;
+    var host: ?[]i32 = null;
+
+    fn envN(comptime name: [*:0]const u8, d: usize) usize {
+        if (std.c.getenv(name)) |m| return std.fmt.parseInt(usize, std.mem.span(m), 10) catch d;
+        return d;
+    }
+
+    pub fn on() bool {
+        if (state < 0) {
+            state = 0;
+            if (std.c.getenv("TF_FLASHNEXT_Q38_QDUMP")) |e| {
+                left = envN("TF_FLASHNEXT_Q38_QDUMP_MAX", 6);
+                skip = envN("TF_FLASHNEXT_Q38_QDUMP_SKIP", 0);
+                step = @max(1, envN("TF_FLASHNEXT_Q38_QDUMP_STEP", 1));
+                fd = open(e, 0x441, @as(c_int, 0o644));
+                if (fd >= 0) state = 1;
+                std.debug.print("q38: attention key lists to {s} (fd {d}, max {d}, skip {d}, step {d})\n", .{ std.mem.span(e), fd, left, skip, step });
+            }
+        }
+        return state == 1 and left > 0;
+    }
+
+    pub fn dump(self: anytype, ids: u64, nk: u64, spr: u64, rows: usize, idw: usize, pos0: usize) !void {
+        seen += 1;
+        if (seen <= skip or (seen - skip - 1) % step != 0) return;
+        const d = self.stream.d;
+        try self.stream.synchronize();
+        const words = rows * (idw + 2);
+        if (host == null or host.?.len < words) host = std.heap.c_allocator.alloc(i32, words) catch return;
+        const h = host.?;
+        try d.check(d.api.cuMemcpyDtoH_v2(h.ptr, nk, rows * 4), "cuMemcpyDtoH");
+        try d.check(d.api.cuMemcpyDtoH_v2(h.ptr + rows, spr, rows * 4), "cuMemcpyDtoH");
+        try d.check(d.api.cuMemcpyDtoH_v2(h.ptr + 2 * rows, ids, rows * idw * 4), "cuMemcpyDtoH");
+        const head = [4]u32{ 0x51444D50, @intCast(rows), @intCast(idw), @intCast(pos0) };
+        _ = write(fd, std.mem.asBytes(&head).ptr, 16);
+        _ = write(fd, std.mem.sliceAsBytes(h[0..words]).ptr, words * 4);
+        left -|= 1;
+    }
+};
