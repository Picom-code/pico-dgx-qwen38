diff --git a/zig/kernels/cuda/q38_pdl.cuh b/zig/kernels/cuda/q38_pdl.cuh
new file mode 100644
index 0000000..3b5c80d
--- /dev/null
+++ b/zig/kernels/cuda/q38_pdl.cuh
@@ -0,0 +1,10 @@
+// q38: programmatic dependent launch for the decode step's small kernels (used only when the launch carries the attribute,
+// TF_FLASHNEXT_Q38_PDL=1; otherwise both instructions are no-ops). The kernel lets the next one spin up, then waits for every kernel
+// ahead of it before it reads or writes anything, so the stream's order of effects is unchanged.
+#pragma once
+__device__ __forceinline__ void q38_pdl() {
+#if __CUDA_ARCH__ >= 900
+    asm volatile("griddepcontrol.launch_dependents;\n" ::: "memory");
+    asm volatile("griddepcontrol.wait;\n" ::: "memory");
+#endif
+}
