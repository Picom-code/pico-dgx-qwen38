+/// TF_FLASHNEXT_Q38_PDL=1 (q38, off unless set): kernels on the q38 list are launched with the programmatic-dependent-launch attribute.
+/// Each of them waits for the kernels ahead of it before touching data, so only launch latency changes, never results.
+const Q38Pdl = struct {
+    const names = @import("q38_pdl_names.zig");
+    const Slot = struct { h: usize = 0, ok: bool = false };
+    var state: i8 = -1;
+    var slots: [1024]Slot = @splat(.{});
+    var busy: u8 = 0;
+
+    fn on() bool {
+        if (state < 0) state = if (std.c.getenv("TF_FLASHNEXT_Q38_PDL")) |v| @intFromBool(v[0] == '1') else 0;
+        return state == 1;
+    }
+
+    fn allowed(d: anytype, handle: abi.Function) bool {
+        while (@atomicRmw(u8, &busy, .Xchg, 1, .acquire) != 0) {}
+        defer @atomicStore(u8, &busy, 0, .release);
+        const h: usize = @intFromPtr(handle);
+        var i: usize = (h >> 4) % slots.len;
+        var probes: usize = 0;
+        while (slots[i].h != 0 and slots[i].h != h and probes < slots.len) : (probes += 1) i = (i + 1) % slots.len;
+        if (slots[i].h == h) return slots[i].ok;
+        if (slots[i].h != 0) return false;
+        const name = d.functionName(handle);
+        var ok = false;
+        for (names.names) |n| {
+            if (std.mem.eql(u8, n, name)) ok = true;
+        }
+        for (names.prefixes) |p| {
+            if (std.mem.startsWith(u8, name, p)) ok = true;
+        }
+        slots[i] = .{ .h = h, .ok = ok };
+        return ok;
+    }
+};
+
+/// TF_HOSTPROF=N (q38 measuring aid, off unless set): every N launches, the host time spent inside the driver's launch calls
+/// and the wall time over the same launches ("hostprof launches N in-driver-ms X wall-ms Y").
+const HostProf = struct {
+    var state: i64 = -1;
+    var n: u64 = 0;
+    var ns: u64 = 0;
+    var wall0: u64 = 0;
+
+    fn on() bool {
+        if (state < 0) {
+            var v: i64 = 0;
+            if (std.c.getenv("TF_HOSTPROF")) |e| v = std.fmt.parseInt(i64, std.mem.span(e), 10) catch 0;
+            state = if (v > 0) v else 0;
+        }
+        return state > 0;
+    }
+
+    fn add(d: u64) void {
+        if (n == 0) wall0 = KProf.now();
+        n += 1;
+        ns += d;
+        if (n >= @as(u64, @intCast(state))) {
+            const w = KProf.now() - wall0;
+            std.debug.print("hostprof launches {d} in-driver-ms {d:.2} wall-ms {d:.2}\n", .{ n, @as(f64, @floatFromInt(ns)) / 1e6, @as(f64, @floatFromInt(w)) / 1e6 });
+            n = 0;
+            ns = 0;
+        }
+    }
+};
