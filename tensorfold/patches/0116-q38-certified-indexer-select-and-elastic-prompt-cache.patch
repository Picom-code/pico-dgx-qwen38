+pub fn bufs(d: *const cuda.Driver) ?Bufs {
+    if (failed) return null;
+    if (knb == null) {
+        var a = cuda.DeviceBuffer.alloc(d, max_tiles * 4) catch {
+            failed = true;
+            return null;
+        };
+        var b = cuda.DeviceBuffer.alloc(d, stats_n * 8) catch {
+            a.free();
+            failed = true;
+            return null;
+        };
+        d.check(d.api.cuMemsetD8_v2(b.ptr, 0, stats_n * 8), "cuMemsetD8") catch {
+            a.free();
+            b.free();
+            failed = true;
+            return null;
+        };
+        knb = a;
+        stats = b;
+    }
+    return .{ .knb = knb.?.ptr, .stats = stats.?.ptr };
+}
+
+/// Check mode: a second score buffer of at least `bytes` (an outgrown one is left allocated: queued launches may still read it).
+pub fn refScores(d: *const cuda.Driver, bytes: usize) ?u64 {
+    if (ref) |r| if (r.len >= bytes) return r.ptr;
+    const b = cuda.DeviceBuffer.alloc(d, bytes) catch return null;
+    ref = b;
+    return b.ptr;
+}
+
+/// One line of the counters so far (the caller has the pass's results, so its launches are done).
+pub fn report(d: *const cuda.Driver, what: []const u8) void {
+    const s = stats orelse return;
+    var h: [stats_n]u64 = undefined;
+    d.check(d.api.cuMemcpyDtoH_v2(&h, s.ptr, stats_n * 8), "cuMemcpyDtoH") catch return;
+    const ratio: f32 = @bitCast(@as(u32, @truncate(h[7])));
+    std.debug.print("q38 qsacert {s} rows={d} between={d} fallback={d} max_between={d} redone={d} checked={d} list_diff={d} exact_bit_diff={d} bound_viol={d} max_ratio={d:.5}\n", .{ what, h[0], h[1], h[2], h[3], h[4], h[9], h[8], h[5], h[6], ratio });
+}
