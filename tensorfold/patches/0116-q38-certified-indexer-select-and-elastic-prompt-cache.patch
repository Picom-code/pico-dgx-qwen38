+    /// q38 (TF_FLASHNEXT_Q38_CACHE_ELASTIC): the budget follows the room the streams leave. Sets it and, when it shrank, evicts in the
+    /// usual order (spare storage, superseded states, then the least recently used) until the kept states fit; false when states
+    /// borrowed by passes under way keep it over.
+    pub fn q38Resize(s: *Store, budget: u64) bool {
+        s.budget = budget;
+        while (s.held + s.spare() > s.budget) {
+            if (s.family.vtable.trim) |f| {
+                const before = s.spare();
+                f(s.family.ptr, s.budget -| s.held);
+                if (s.spare() < before) continue;
+            }
+            const i = s.victimBut(null, &.{}, std.math.maxInt(u32)) orelse return false;
+            s.remove(i);
+            s.counts.evicted += 1;
+        }
+        return true;
+    }
+
     /// The family's free storage kept for later saves.
     pub fn spare(s: *const Store) u64 {
