@@ -0,0 +1,58 @@
+//! q38 round 11: knobs and measuring aids of the copy drafts (context copies, a client's `prediction`, Recall). Drafts only: none of this
+//! can change a reply, every copied token is kept only where it equals the model's own.
+const std = @import("std");
+
+fn envInt(comptime name: [:0]const u8, default: i64) i64 {
+    const st = struct {
+        var read: bool = false;
+        var value: i64 = 0;
+        const tag = name; // one cache a knob (a struct in a generic function is one type unless it names a comptime value)
+    };
+    if (!st.read) {
+        st.value = if (std.c.getenv(st.tag)) |v| std.fmt.parseInt(i64, std.mem.span(v), 10) catch default else default;
+        st.read = true;
+    }
+    return st.value;
+}
+
+/// TF_Q38_COPY_OFF=1 (measuring aid): no copy window at all (the head's chain everywhere), for chain-only logs that copy policies are replayed on.
+pub fn off() bool {
+    return envInt("TF_Q38_COPY_OFF", 0) == 1;
+}
+
+/// TF_Q38_COPY_MATCH=N (0: the lane core's 8): matching tokens a context copy needs.
+pub fn match() i64 {
+    return envInt("TF_Q38_COPY_MATCH", 0);
+}
+
+/// TF_Q38_COPY_FIRST=1 (default off): a lone stream's copy window starts wider when the match that lets it in is long and no broken copy is
+/// pending: 63 tokens from a 16-token match, 127 from a 32-token match (within the window's rows), instead of 15 then doubling. Read off a
+/// replay of logged agent and rewrite requests: such copies keep 59-80 tokens on average, a 4-7 token match keeps 4.
+pub fn first() bool {
+    return envInt("TF_Q38_COPY_FIRST", 0) == 1;
+}
+
+/// TF_Q38_COPY_REENTER=N (0: off): after a copy that broke late (4 or more of its tokens kept) a match of N tokens is enough for the next copy
+/// (the reply left the source for an edit and is back in it), instead of the 8 a first copy needs.
+pub fn reenter() i64 {
+    return envInt("TF_Q38_COPY_REENTER", 0);
+}
+
+/// TF_Q38_COPY_SHARED=1 (default off): with several streams in flight a stream's copy window keeps the lone stream's ramp (15, then doubled after
+/// each copy that landed whole, back to 15 after a break) up to the pass's rows a live stream, instead of staying at 15. For several
+/// agents rewriting files at once.
+pub fn shared() bool {
+    return envInt("TF_Q38_COPY_SHARED", 0) >= 1;
+}
+
+/// 1: the cap is an even share of the pass (rows / live streams - 1); 2: the rows left when every other live stream takes a 16-row window.
+pub fn sharedMode() i64 {
+    return envInt("TF_Q38_COPY_SHARED", 0);
+}
+
+/// Set by the round loop before it asks the proposer: the match a copy out of the prediction needs this time (0: its own rule).
+pub var low_match: i64 = 0;
+
+/// The last proposal's real match length and source, for TF_STEP_LOG's QCOPY line (engine thread only).
+pub var last_match: i64 = 0;
+pub var last_side: bool = false;
