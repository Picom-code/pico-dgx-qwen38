+/// q38 (TF_FLASHNEXT_Q38_SGATE): a keyed candidate draw re-played for the stop rule. `top`: the best candidate's temperature-1 probability;
+/// `drawn`: the drawn token's temperature-1 probability (what stock feeds the rule); `drawn_t`: its probability inside the tempered
+/// top_k / top_p / min_p set; `margin`: the winner's lead over the runner-up in the keyed race (1e9 when the set holds one token);
+/// `keep`: the set's size. Reads only; the draw itself is drawCandidates'.
+pub const DrawStats = struct { token: u32 = 0, top: f64 = 0, drawn: f64 = 0, drawn_t: f64 = 0, margin: f64 = 0, keep: u32 = 0 };
+
+pub fn drawStats(vals: []const f32, cols: []const i32, ids: []const u32, lse: f32, position: u64, s: Sampling) DrawStats {
+    const n = vals.len;
+    if (n == 0 or n > cand_max or n != cols.len) return .{};
+    var v: [cand_max]f64 = undefined;
+    var key: [cand_max]u64 = undefined;
+    // the draw's order: by value, then the lower id (insertion sort of at most 64)
+    for (0..n) |i| {
+        const x: f64 = vals[i];
+        const id: u64 = ids[@intCast(cols[i])];
+        var at = i;
+        while (at > 0 and (x > v[at - 1] or (x == v[at - 1] and id < key[at - 1]))) : (at -= 1) {
+            v[at] = v[at - 1];
+            key[at] = key[at - 1];
+        }
+        v[at] = x;
+        key[at] = id;
+    }
+    const k = @max(1, @min(if (s.top_k != 0) @as(usize, s.top_k) else n, n));
+    const t = @max(s.temperature, 1e-6);
+    var probs: [cand_max]f64 = undefined;
+    var total: f64 = 0;
+    for (0..k) |j| {
+        probs[j] = @exp((v[j] - v[0]) / t);
+        total += probs[j];
+    }
+    var keep = k;
+    if (s.top_p > 0.0 and s.top_p < 1.0) {
+        var cum: f64 = 0;
+        var below: usize = 0;
+        for (0..k) |j| {
+            cum += probs[j] / total;
+            if (cum < s.top_p) below += 1;
+        }
+        keep = @min(keep, below + 1);
+    }
+    if (s.min_p > 0.0) {
+        var m: usize = 0;
+        for (0..keep) |j| {
+            if ((v[j] - v[0]) / t >= @log(s.min_p)) m += 1;
+        }
+        keep = @max(1, m);
+    }
+    var best: usize = 0;
+    var best_score = -std.math.inf(f64);
+    var second = -std.math.inf(f64);
+    var kept: f64 = 0;
+    for (0..keep) |j| {
+        kept += probs[j];
+        const score = v[j] / t - @log(-@log(lanes.sampling.uniform(s.seed, position, key[j])));
+        if (j == 0 or score > best_score) {
+            if (j > 0) second = best_score;
+            best = j;
+            best_score = score;
+        } else if (score > second) second = score;
+    }
+    return .{
+        .token = @intCast(key[best]),
+        .top = @exp(v[0] - @as(f64, lse)),
+        .drawn = @exp(v[best] - @as(f64, lse)),
+        .drawn_t = probs[best] / kept,
+        .margin = if (keep <= 1) 1e9 else best_score - second,
+        .keep = @intCast(keep),
+    };
+}
+
+/// The stop rule's input for a sampled candidate draw under TF_FLASHNEXT_Q38_SGATE (mode 0, or a re-play that disagrees with the draw: `stock`).
+pub fn sampledGate(stock: f64, token: u32, vals: []const f32, cols: []const i32, ids: []const u32, lse: f32, position: u64, sm: ?Sampling) f64 {
+    const g = @import("cuda_knobs.zig").q38SGate();
+    const log_on = @import("cuda_mtp_ops.zig").stepLogOn();
+    if (g.mode == 0 and !log_on) return stock;
+    const s = sm orelse return stock;
+    const st = drawStats(vals, cols, ids, lse, position, s);
+    if (log_on) std.debug.print("QSAMP {d} {d:.5} {d:.5} {d:.5} {d:.4} {d} {d}\n", .{ token, st.drawn, st.top, st.drawn_t, @min(st.margin, 99.0), st.keep, @intFromBool(st.token == token) });
+    if (st.keep == 0 or st.token != token) return stock;
+    return switch (g.mode) {
+        1 => st.top,
+        2 => st.drawn_t,
+        3 => 1.0 / (1.0 + @exp(-(g.a * @min(st.margin, 60.0) + g.b))),
+        else => stock,
+    };
+}
