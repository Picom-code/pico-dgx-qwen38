+/// TF_FLASHNEXT_Q38_SGATE=M[,A,B[,C]] (q38; default 0: stock): what the draft chain's stop rule is fed for a SAMPLED stream (temperature > 0)
+/// whose draw came from its row's top_k candidates. Stock (0) feeds the drawn token's temperature-1 probability under the draft head, as
+/// for a greedy stream. But a sampled draft is kept when the target's keyed draw (the same Gumbel noise) lands on the same token, which
+/// depends on how far the draft's winner is ahead in the keyed race, not on how likely the token was. M = 1: the head's best token's
+/// temperature-1 probability; 2: the drawn token's probability inside the tempered top_k / top_p set; 3: 1 / (1 + exp(-(A margin + B))),
+/// margin = the winner's lead over the runner-up in the keyed race (scaled logit + Gumbel noise; a set of one token counts as a wide lead).
+/// C (0: the stream's own TF_FLASHNEXT_CONFIDENCE): the running-product line for sampled streams (0.4 stock).
+/// Drafts only: every kept token is still the target's draw. With TF_FLASHNEXT_Q38_KNOBFILE the words sgate, sgate_a, sgate_b, sgate_c
+/// (a, b, c in thousandths) override at every use.
+pub const SGate = struct { mode: u8 = 0, a: f64 = 1.0, b: f64 = 0.0, c: f64 = 0.0 };
+var sgate_cache: ?SGate = null;
+pub fn q38SGate() SGate {
+    if (sgate_cache == null) {
+        var g: SGate = .{};
+        if (std.c.getenv("TF_FLASHNEXT_Q38_SGATE")) |e| {
+            var it = std.mem.splitScalar(u8, std.mem.span(e), ',');
+            if (it.next()) |x| g.mode = std.fmt.parseInt(u8, x, 10) catch 0;
+            if (it.next()) |x| g.a = std.fmt.parseFloat(f64, x) catch 1.0;
+            if (it.next()) |x| g.b = std.fmt.parseFloat(f64, x) catch 0.0;
+            if (it.next()) |x| g.c = std.fmt.parseFloat(f64, x) catch 0.0;
+        }
+        sgate_cache = g;
+    }
+    var g = sgate_cache.?;
+    if (std.c.getenv("TF_FLASHNEXT_Q38_KNOBFILE") != null) {
+        if (q38KnobFile("sgate")) |v| g.mode = @intCast(std.math.clamp(v, 0, 9));
+        if (q38KnobFile("sgate_a")) |v| g.a = @as(f64, @floatFromInt(v)) / 1000.0;
+        if (q38KnobFile("sgate_b")) |v| g.b = @as(f64, @floatFromInt(v)) / 1000.0;
+        if (q38KnobFile("sgate_c")) |v| g.c = @as(f64, @floatFromInt(v)) / 1000.0;
+    }
+    return g;
+}
