 }
 
+// q38 certified TOP-K head (TF_FLASHNEXT_Q38_CERT_TOPK): fn_cert_select for a row whose draw reads its `topk` best scores (a keyed
+// sampled draw over top_k candidates). theta = a value with at least `topk` entries whose LOWER bound A - c h is >= theta (found from a
+// 256-bin histogram of the lower bounds within 32 logits of the best one, an eighth of a logit a bin: the lower edge of the bin where
+// the count reaches topk). At least topk exact scores are >= theta, so an entry whose UPPER bound A + c h is under theta less two bf16
+// steps is strictly below the topk-th largest rounded score: it is not among the row's topk best and cannot tie with one. The tiles
+// of every other entry are flagged. No such theta within 32 logits: theta = -inf, every tile is flagged (the caller takes the whole head).
+extern "C" __global__ void __launch_bounds__(1024) fn_cert_select_k(const float* __restrict__ A, const float* __restrict__ c,
+                                                                    const __nv_bfloat16* __restrict__ x, int ldx, int K, int V,
+                                                                    __nv_bfloat16* __restrict__ out, unsigned* __restrict__ flags,
+                                                                    float* __restrict__ info, int topk) {
+    const int r = blockIdx.x, t = threadIdx.x, lane = t & 31, warp = t >> 5, warps = blockDim.x >> 5;
+    __shared__ float sa[32];
+    __shared__ float sb[32];
+    __shared__ float g0, g1, gth;
+    __shared__ unsigned hist[256];
+    const __nv_bfloat16* xr = x + static_cast<long long>(r) * ldx;
+    float s = 0.0f;
+    for (int i = t; i < K; i += blockDim.x) {
+        const float v = __bfloat162float(xr[i]);
+        s = s + v * v;
+    }
+    for (int o = 16; o; o >>= 1) s = s + __shfl_xor_sync(0xffffffffu, s, o);
+    if (lane == 0) sa[warp] = s;
+    if (t < 256) hist[t] = 0u;
+    __syncthreads();
+    if (warp == 0) {
+        s = lane < warps ? sa[lane] : 0.0f;
+        for (int o = 16; o; o >>= 1) s = s + __shfl_xor_sync(0xffffffffu, s, o);
+        if (lane == 0) g0 = sqrtf(s) * 1.0001f;
+    }
+    __syncthreads();
+    const float h = g0;
+    const float* a = A + static_cast<long long>(r) * V;
+    float lo = -CUDART_INF_F, hi = -CUDART_INF_F;
+    bool bad = false;
+    for (int i = t; i < V; i += blockDim.x) {
+        const float v = a[i], b = c[i] * h;
+        if (!(fabsf(v) < CUDART_INF_F)) bad = true;
+        lo = fmaxf(lo, v - b);
+        hi = fmaxf(hi, v + b);
+    }
+    if (bad) lo = CUDART_NAN_F;
+    for (int o = 16; o; o >>= 1) {
+        const float l2 = __shfl_xor_sync(0xffffffffu, lo, o), h2 = __shfl_xor_sync(0xffffffffu, hi, o);
+        lo = (lo != lo || l2 != l2) ? CUDART_NAN_F : fmaxf(lo, l2);
+        hi = fmaxf(hi, h2);
+    }
+    __syncthreads();
+    if (lane == 0) {
+        sa[warp] = lo;
+        sb[warp] = hi;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        lo = lane < warps ? sa[lane] : -CUDART_INF_F;
+        hi = lane < warps ? sb[lane] : -CUDART_INF_F;
+        for (int o = 16; o; o >>= 1) {
+            const float l2 = __shfl_xor_sync(0xffffffffu, lo, o), h2 = __shfl_xor_sync(0xffffffffu, hi, o);
+            lo = (lo != lo || l2 != l2) ? CUDART_NAN_F : fmaxf(lo, l2);
+            hi = fmaxf(hi, h2);
+        }
+        if (lane == 0) {
+            g0 = lo;
+            g1 = hi;
+        }
+    }
+    __syncthreads();
+    lo = g0;
+    hi = g1;
+    if (lo == lo) {
+        for (int i = t; i < V; i += blockDim.x) {
+            const float d = (lo - (a[i] - c[i] * h)) * 8.0f;
+            if (d < 256.0f) atomicAdd(&hist[d > 0.0f ? static_cast<int>(d) : 0], 1u);
+        }
+    }
+    __syncthreads();
+    if (t == 0) {
+        float th = -CUDART_INF_F;
+        unsigned cum = 0u;
+        for (int b = 0; b < 256; ++b) {
+            cum += hist[b];
+            if (cum >= static_cast<unsigned>(topk)) {
+                th = lo - static_cast<float>(b + 1) * 0.125f;
+                break;
+            }
+        }
+        gth = th;
+    }
+    __syncthreads();
+    const float th = gth;
+    const float m = fmaxf(fmaxf(fabsf(lo), fabsf(hi)), fabsf(th));
+    int e = 0;
+    frexpf(m, &e);                                       // m in [2^(e-1), 2^e): a bf16 step there is 2^(e-8)
+    const float step = ldexpf(1.0f, e - 8);
+    const float thr = (th > -CUDART_INF_F) ? th - 2.0f * step - 1e-5f * (1.0f + m) : -CUDART_INF_F;
+    __nv_bfloat16* orow = out + static_cast<long long>(r) * V;
+    const __nv_bfloat16 ninf = __float2bfloat16_rn(-CUDART_INF_F);
+    for (int i = t; i < V; i += blockDim.x) {
+        if (a[i] + c[i] * h >= thr) flags[i >> 6] = 1u;
+        orow[i] = ninf;
+    }
+    if (t == 0) {
+        info[4 * r] = lo;
+        info[4 * r + 1] = hi;
+        info[4 * r + 2] = thr;
+        info[4 * r + 3] = h;
+    }
+}
+
+// Check mode: every coarse score against the whole head's score. A [rows, V] fp32 coarse, c [V], info [rows, 4] (h in slot 3),
+// b [rows, V] bf16 the whole head's rows. stats[4] += entries with |A - b| > c h + half a bf16 step of b (the bound the selection
+// relies on, tested for every entry of every checked row); stats[5] += entries tested (in units of 1024).
+extern "C" __global__ void __launch_bounds__(1024) fn_cert_bound(const float* __restrict__ A, const float* __restrict__ c,
+                                                                 const float* __restrict__ info, const __nv_bfloat16* __restrict__ b,
+                                                                 int V, unsigned* __restrict__ stats) {
+    const int r = blockIdx.x, t = threadIdx.x;
+    const float h = info[4 * r + 3];
+    const float* a = A + static_cast<long long>(r) * V;
+    unsigned bad = 0u, n = 0u;
+    for (int i = t; i < V; i += blockDim.x) {
+        const float y = __bfloat162float(b[static_cast<long long>(r) * V + i]);
+        if (!(fabsf(a[i] - y) <= c[i] * h + fabsf(y) * (1.01f / 256.0f) + 1e-6f)) bad += 1u;
+        n += 1u;
+    }
+    for (int o = 16; o; o >>= 1) {
+        bad += __shfl_xor_sync(0xffffffffu, bad, o);
+        n += __shfl_xor_sync(0xffffffffu, n, o);
+    }
+    if ((t & 31) == 0) {
+        if (bad) atomicAdd(stats + 4, bad);
+        atomicAdd(stats + 5, n >> 10);
+    }
+}
+
 // Program (row), 1024 threads: the certified head's rows `a` against the whole head's rows `b` ([rows, V] bf16). stats[0] rows,
 // [1] rows whose best (value, then lowest id) differs, [2] entries `a` holds (not -inf) whose bits differ from `b`, [3] entries held.
 extern "C" __global__ void __launch_bounds__(1024) fn_cert_check(const __nv_bfloat16* __restrict__ a, const __nv_bfloat16* __restrict__ b,
