+extern "c" fn open(path: [*:0]const u8, flags: c_int, ...) c_int;
+extern "c" fn write(fd: c_int, buf: [*]const u8, n: usize) isize;
+
+/// TF_FLASHNEXT_Q38_HDUMP=PREFIX (q38 measuring aid, off unless set): every head call's input rows (the mixed rows the LM head
+/// multiplies, [n, dims] bf16) are appended to PREFIX.x and the call's row count (u32) to PREFIX.n, up to
+/// TF_FLASHNEXT_Q38_HDUMP_MAX rows (default 400000). It waits for the stream at each head call; values never change.
+const Hdump = struct {
+    var state: i8 = -1;
+    var fx: c_int = -1;
+    var fnn: c_int = -1;
+    var left: usize = 400000;
+    var host: [64 * dims * 2]u8 = undefined;
+
+    fn on() bool {
+        if (state < 0) {
+            state = 0;
+            if (std.c.getenv("TF_FLASHNEXT_Q38_HDUMP")) |e| {
+                var buf: [512]u8 = undefined;
+                const pre = std.mem.span(e);
+                if (std.c.getenv("TF_FLASHNEXT_Q38_HDUMP_MAX")) |m| left = std.fmt.parseInt(usize, std.mem.span(m), 10) catch left;
+                const a = std.fmt.bufPrint(buf[0..510], "{s}.x", .{pre}) catch return false;
+                buf[a.len] = 0;
+                fx = open(@ptrCast(&buf), 0x441, @as(c_int, 0o644));
+                const b = std.fmt.bufPrint(buf[0..510], "{s}.n", .{pre}) catch return false;
+                buf[b.len] = 0;
+                fnn = open(@ptrCast(&buf), 0x441, @as(c_int, 0o644));
+                if (fx >= 0 and fnn >= 0) state = 1;
+                std.debug.print("q38: head dump to {s} (fds {d} {d}, max rows {d})\n", .{ pre, fx, fnn, left });
+            }
+        }
+        return state == 1 and left > 0;
+    }
+
+    fn rows(self: anytype, n: usize) !void {
+        if (n == 0 or n > 64) return;
+        const d = self.stream.d;
+        try self.stream.synchronize();
+        try d.check(d.api.cuMemcpyDtoH_v2(&host, self.s.mixed, n * dims * 2), "cuMemcpyDtoH");
+        _ = write(fx, &host, n * dims * 2);
+        const c: u32 = @intCast(n);
+        _ = write(fnn, std.mem.asBytes(&c).ptr, 4);
+        left -|= n;
+    }
+};
