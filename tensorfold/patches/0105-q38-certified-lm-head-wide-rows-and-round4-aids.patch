+        info[4 * r + 1] = hi;
+        info[4 * r + 2] = thr;
+        info[4 * r + 3] = h;
+    }
+}
+
+// Program (row), 1024 threads: the certified head's rows `a` against the whole head's rows `b` ([rows, V] bf16). stats[0] rows,
+// [1] rows whose best (value, then lowest id) differs, [2] entries `a` holds (not -inf) whose bits differ from `b`, [3] entries held.
+extern "C" __global__ void __launch_bounds__(1024) fn_cert_check(const __nv_bfloat16* __restrict__ a, const __nv_bfloat16* __restrict__ b,
+                                                                 int V, unsigned* __restrict__ stats) {
+    const int r = blockIdx.x, t = threadIdx.x, lane = t & 31, warp = t >> 5, warps = blockDim.x >> 5;
+    const unsigned short* ar = reinterpret_cast<const unsigned short*>(a) + static_cast<long long>(r) * V;
+    const unsigned short* br = reinterpret_cast<const unsigned short*>(b) + static_cast<long long>(r) * V;
+    float va = -CUDART_INF_F, vb = -CUDART_INF_F;
+    int ia = 0x7fffffff, ib = 0x7fffffff;
+    unsigned diff = 0, held = 0;
+    for (int i = t; i < V; i += blockDim.x) {
+        const float x = __bfloat162float(a[static_cast<long long>(r) * V + i]), y = __bfloat162float(b[static_cast<long long>(r) * V + i]);
+        if (x > va) { va = x; ia = i; }
+        if (y > vb) { vb = y; ib = i; }
+        if (ar[i] != 0xFF80u) {
+            held += 1;
+            if (ar[i] != br[i]) diff += 1;
+        }
+    }
+    __shared__ float sva[32];
+    __shared__ float svb[32];
+    __shared__ int sia[32];
+    __shared__ int sib[32];
+    __shared__ unsigned sd[32];
+    __shared__ unsigned sh[32];
+#define Q38_MERGE(v, i, v2, i2) if ((v2) > (v) || ((v2) == (v) && (i2) < (i))) { (v) = (v2); (i) = (i2); }
+    for (int o = 16; o; o >>= 1) {
+        const float xa = __shfl_xor_sync(0xffffffffu, va, o), xb = __shfl_xor_sync(0xffffffffu, vb, o);
+        const int ja = __shfl_xor_sync(0xffffffffu, ia, o), jb = __shfl_xor_sync(0xffffffffu, ib, o);
+        Q38_MERGE(va, ia, xa, ja)
+        Q38_MERGE(vb, ib, xb, jb)
+        diff += __shfl_xor_sync(0xffffffffu, diff, o);
+        held += __shfl_xor_sync(0xffffffffu, held, o);
+    }
+    if (lane == 0) {
+        sva[warp] = va; svb[warp] = vb; sia[warp] = ia; sib[warp] = ib; sd[warp] = diff; sh[warp] = held;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        va = lane < warps ? sva[lane] : -CUDART_INF_F;
+        vb = lane < warps ? svb[lane] : -CUDART_INF_F;
+        ia = lane < warps ? sia[lane] : 0x7fffffff;
+        ib = lane < warps ? sib[lane] : 0x7fffffff;
+        diff = lane < warps ? sd[lane] : 0u;
+        held = lane < warps ? sh[lane] : 0u;
+        for (int o = 16; o; o >>= 1) {
+            const float xa = __shfl_xor_sync(0xffffffffu, va, o), xb = __shfl_xor_sync(0xffffffffu, vb, o);
+            const int ja = __shfl_xor_sync(0xffffffffu, ia, o), jb = __shfl_xor_sync(0xffffffffu, ib, o);
+            Q38_MERGE(va, ia, xa, ja)
+            Q38_MERGE(vb, ib, xb, jb)
+            diff += __shfl_xor_sync(0xffffffffu, diff, o);
+            held += __shfl_xor_sync(0xffffffffu, held, o);
+        }
+        if (lane == 0) {
+            atomicAdd(&stats[0], 1u);
+            if (ia != ib || !(va == vb)) atomicAdd(&stats[1], 1u);
+            atomicAdd(&stats[2], diff);
+            atomicAdd(&stats[3], held);
+        }
+    }
+#undef Q38_MERGE
+}
