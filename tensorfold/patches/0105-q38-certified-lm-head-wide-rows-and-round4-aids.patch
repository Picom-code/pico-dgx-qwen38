diff --git a/zig/src/families/flashnext/cuda_cert.zig b/zig/src/families/flashnext/cuda_cert.zig
new file mode 100644
index 0000000..60b0cb7
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_cert.zig
@@ -0,0 +1,305 @@
+//! q38: certified exact LM head for greedy verify windows (TF_FLASHNEXT_Q38_CERT=1; 2 also checks every call against the whole head).
+//!
+//! The head is BF16 [vocab, dims], 1.18 GiB read for every pass. Here a pass first reads an MXFP8 copy made at load (E4M3 codes,
+//! one power-of-two scale per 32 inputs: half the bytes), which gives each score to within c[v] * ||x|| (Cauchy-Schwarz on the
+//! copy's measured residual, plus a float-rounding allowance). Entries that cannot be, or tie with, a row's best are ruled out; the
+//! 64-entry tiles holding the others are then computed by the head's own kernel on the BF16 weights (qmmf.Lane.matmulTiles: the
+//! same blocks on the same bytes, so the same bits) into a row otherwise filled with -inf. The row's best and its id are therefore
+//! the whole head's. A pass with too many tiles left, a NaN, more than `max_rows` rows, or any stream that samples, masks or wants
+//! log-probabilities takes the whole head (`round_ok` is set only by the verify windows of all-greedy rounds).
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const wt = @import("cuda_prompt_wt.zig");
+
+const dims = wt.dims;
+const vocab = wt.vocab;
+/// Rows a pass may hold (the widest drafted verify pass, TF_FLASHNEXT_Q38_WIDE_ROWS); the exact kernel takes them 64 at a time.
+pub const max_rows = 256;
+const tile_rows = 64;
+const tiles_n = vocab / 64;
+/// Launches of the exact kernel a pass takes at most, and tiles; beyond either the whole head is cheaper or as cheap.
+const max_runs = 600;
+const max_tiles = 1500;
+/// Runs of flagged tiles closer than this are joined (fewer launches; the extra tiles get their true scores).
+const join_gap = 2;
+
+/// The engine's certified head, if it made one (one engine a process).
+pub var active: ?*Cert = null;
+/// Set by a verify pass whose streams are all greedy with no masks and no log-probabilities, for the pass's head calls.
+pub var round_ok: bool = false;
+
+var mode_cache: i8 = -1;
+/// TF_FLASHNEXT_Q38_CERT: 0 or unset off, 1 on, 2 on and checked against the whole head.
+pub fn mode() u8 {
+    if (mode_cache < 0) {
+        mode_cache = 0;
+        if (std.c.getenv("TF_FLASHNEXT_Q38_CERT")) |e| {
+            const t = std.mem.span(e);
+            if (std.mem.eql(u8, t, "1")) mode_cache = 1;
+            if (std.mem.eql(u8, t, "2")) mode_cache = 2;
+        }
+    }
+    return @intCast(mode_cache);
+}
+
+/// The nearest E4M3 code of y (|y| at most a little over 448; never a NaN code).
+fn encode(y: f32) u8 {
+    const bits: u32 = @bitCast(y);
+    const sign: u8 = @intCast((bits >> 31) << 7);
+    const a: f32 = @abs(y);
+    if (a < 0.015625) {
+        const m: u32 = @intFromFloat(@round(a * 512.0));
+        return sign | @as(u8, @intCast(@min(m, 8)));
+    }
+    const ab: u32 = bits & 0x7fffffff;
+    var e: i32 = @as(i32, @intCast(ab >> 23)) - 127;
+    var m: u32 = ((ab & 0x7fffff) + (1 << 19)) >> 20;
+    if (m == 8) {
+        m = 0;
+        e += 1;
+    }
+    if (e > 8 or (e == 8 and m == 7)) {
+        e = 8;
+        m = 6;
+    }
+    return sign | @as(u8, @intCast((e + 7) << 3)) | @as(u8, @intCast(m));
+}
+
+/// An E4M3 code's value.
+fn decode(c: u8) f64 {
+    const e: i32 = (c >> 3) & 15;
+    const m: f64 = @floatFromInt(c & 7);
+    const v: f64 = if (e == 0) m / 512.0 else (1.0 + m / 8.0) * std.math.ldexp(@as(f64, 1.0), e - 7);
+    return if (c & 0x80 != 0) -v else v;
+}
+
+fn cint(v: usize) c_int {
+    return @intCast(v);
+}
+
+pub const Cert = struct {
+    gpa: std.mem.Allocator,
+    codes: cuda.DeviceBuffer,
+    scales: cuda.DeviceBuffer,
+    weight: cuda.qmmf.Weight,
+    c: cuda.DeviceBuffer, // [vocab] fp32
+    approx: cuda.DeviceBuffer, // [max_rows, vocab] fp32
+    flags: cuda.DeviceBuffer, // [tiles_n] u32
+    info: cuda.DeviceBuffer, // [max_rows, 4] fp32
+    chk: cuda.DeviceBuffer, // [max_rows, vocab] bf16 (check mode)
+    stats: cuda.DeviceBuffer, // [4] u32 (check mode)
+    check: bool,
+    rows_cap: usize,
+    host_flags: [tiles_n]u32 = undefined,
+    host_info: [max_rows * 4]f32 = undefined,
+    calls: u64 = 0,
+    rows: u64 = 0,
+    fallbacks: u64 = 0,
+    tiles: u64 = 0,
+    runs: u64 = 0,
+    resid: f64 = 0,
+
+    /// The MXFP8 copy and each vocabulary row's bound from the checkpoint's BF16 head (row-major bytes).
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, head: core.safetensors.Tensor) !*Cert {
+        if (!head.is(.bf16, &.{ vocab, dims }) or vocab % 128 != 0 or dims % 64 != 0) return error.UnexpectedTensor;
+        const n = vocab;
+        const k = dims;
+        const codes = try gpa.alloc(u8, n * k);
+        defer gpa.free(codes);
+        const scales = try gpa.alloc(u8, n * (k / 32));
+        defer gpa.free(scales);
+        const cb = try gpa.alloc(f32, n);
+        defer gpa.free(cb);
+        var rel: f64 = 0;
+        for (0..n) |r| {
+            var res: f64 = 0;
+            var w2: f64 = 0;
+            for (0..k / 32) |g| {
+                var blk: [32]f32 = undefined;
+                var mx: f32 = 0;
+                for (&blk, 0..) |*v, i| {
+                    const at = (r * k + g * 32 + i) * 2;
+                    const b16: u32 = std.mem.readInt(u16, head.bytes[at..][0..2], .little);
+                    v.* = @bitCast(b16 << 16);
+                    mx = @max(mx, @abs(v.*));
+                }
+                var e: i32 = 0;
+                if (mx > 0 and mx < std.math.inf(f32)) {
+                    const fr = std.math.frexp(mx);
+                    e = if (fr.significand <= 0.875) fr.exponent - 9 else fr.exponent - 8;
+                    e = @max(-126, @min(126, e));
+                }
+                scales[r * (k / 32) + g] = @intCast(e + 127);
+                const inv = std.math.ldexp(@as(f32, 1.0), -e);
+                const sc = std.math.ldexp(@as(f64, 1.0), e);
+                for (blk, 0..) |v, i| {
+                    const code = encode(v * inv);
+                    codes[r * k + g * 32 + i] = code;
+                    const dv = @as(f64, v) - decode(code) * sc;
+                    res += dv * dv;
+                    w2 += @as(f64, v) * @as(f64, v);
+                }
+            }
+            // the residual's norm, plus 1e-3 of the row's norm for fp32 rounding in both kernels (2 x 2560 additions of at most
+            // one unit in the last place each of partial sums no larger than sum |w x|), rounded up
+            cb[r] = @floatCast((@sqrt(res) * 1.0001 + 1.0e-3 * @sqrt(w2)) * 1.0001);
+            if (w2 > 0) rel += @sqrt(res / w2);
+        }
+        const codes_p = try gpa.alloc(u8, cuda.mxfp8.padded(n) * k);
+        defer gpa.free(codes_p);
+        const scales_p = try gpa.alloc(u8, codes_p.len / 32);
+        defer gpa.free(scales_p);
+        cuda.mxfp8.packCodes(codes_p, codes, n, k);
+        cuda.mxfp8.packScales(scales_p, scales, n, k);
+        const self = try gpa.create(Cert);
+        errdefer gpa.destroy(self);
+        const check = mode() == 2;
+        const rows_cap = @min(max_rows, @import("cuda_knobs.zig").wideRows());
+        self.* = .{
+            .gpa = gpa,
+            .codes = try cuda.DeviceBuffer.fromHost(d, codes_p),
+            .scales = try cuda.DeviceBuffer.fromHost(d, scales_p),
+            .weight = undefined,
+            .c = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(cb)),
+            .approx = try cuda.DeviceBuffer.alloc(d, rows_cap * vocab * 4),
+            .flags = try cuda.DeviceBuffer.alloc(d, tiles_n * 4),
+            .info = try cuda.DeviceBuffer.alloc(d, max_rows * 16),
+            .chk = try cuda.DeviceBuffer.alloc(d, if (check) rows_cap * vocab * 2 else 256),
+            .stats = try cuda.DeviceBuffer.alloc(d, 256),
+            .check = check,
+            .rows_cap = rows_cap,
+            .resid = rel / @as(f64, @floatFromInt(n)),
+        };
+        self.weight = cuda.mxfp8.weight(self.codes.ptr, self.scales.ptr, n, k);
+        try d.check(d.api.cuMemsetD32_v2(self.stats.ptr, 0, 64), "cuMemsetD32");
+        std.debug.print("q38 cert: MXFP8 copy of the head made ({d} MiB), mean residual {d:.4} of a row's norm, check {d}\n", .{ (codes_p.len + scales_p.len) >> 20, self.resid, @intFromBool(check) });
+        return self;
+    }
+
+    pub fn deinit(self: *Cert) void {
+        self.codes.free();
+        self.scales.free();
+        self.c.free();
+        self.approx.free();
+        self.flags.free();
+        self.info.free();
+        self.chk.free();
+        self.stats.free();
+        self.gpa.destroy(self);
+    }
+
+    /// The pass's `n` head rows (its mixed rows) into `out` [n, vocab] bf16; false: not taken, the caller runs the whole head.
+    pub fn project(c: *Cert, pass: anytype, out: u64, n: usize) !bool {
+        if (n == 0 or n > c.rows_cap) return false;
+        const k = pass.k;
+        const st = pass.stream;
+        const s = pass.s;
+        const d = st.d;
+        const sel = k.cert_sel orelse return false;
+        const head = pass.m.head.native orelse return false;
+        if (head.mode != .bf16 or head.n != vocab or head.k != dims) return false;
+        try k.native_lane.matmulF32(st, s.mixed, dims, n, c.weight, c.approx.ptr, s.native_part);
+        try d.check(d.api.cuMemsetD32Async(c.flags.ptr, 0, tiles_n, st.handle), "cuMemsetD32Async");
+        var a: cuda.Args = .{};
+        a.add(c.approx.ptr);
+        a.add(c.c.ptr);
+        a.add(s.mixed);
+        a.add(cint(dims));
+        a.add(cint(dims));
+        a.add(cint(vocab));
+        a.add(out);
+        a.add(c.flags.ptr);
+        a.add(c.info.ptr);
+        try cuda.launch.launch(sel, .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 1024 } }, st, &a);
+        try st.synchronize();
+        try d.check(d.api.cuMemcpyDtoH_v2(&c.host_flags, c.flags.ptr, tiles_n * 4), "cuMemcpyDtoH");
+        try d.check(d.api.cuMemcpyDtoH_v2(&c.host_info, c.info.ptr, n * 16), "cuMemcpyDtoH");
+        c.calls += 1;
+        c.rows += n;
+        var fine = true;
+        for (0..n) |r| {
+            if (!std.math.isFinite(c.host_info[4 * r]) or !std.math.isFinite(c.host_info[4 * r + 1])) fine = false;
+        }
+        // runs of flagged tiles, close ones joined
+        var starts: [max_runs]u32 = undefined;
+        var counts: [max_runs]u32 = undefined;
+        var runs: usize = 0;
+        var total: usize = 0;
+        var t: usize = 0;
+        while (fine and t < tiles_n) {
+            if (c.host_flags[t] == 0) {
+                t += 1;
+                continue;
+            }
+            var end = t + 1;
+            var scan = end;
+            while (scan < tiles_n and scan < end + join_gap) {
+                if (c.host_flags[scan] != 0) {
+                    end = scan + 1;
+                    scan = end;
+                } else scan += 1;
+            }
+            if (runs == max_runs) {
+                fine = false;
+                break;
+            }
+            starts[runs] = @intCast(t);
+            counts[runs] = @intCast(end - t);
+            runs += 1;
+            total += end - t;
+            t = end;
+        }
+        if (!fine or runs == 0 or total > max_tiles) {
+            c.fallbacks += 1;
+            c.report(st);
+            return false;
+        }
+        // the exact kernel a row tile (64 rows) at a time, each with the instance the whole pass would take
+        var r0: usize = 0;
+        while (r0 < n) : (r0 += tile_rows) {
+            const m = @min(tile_rows, n - r0);
+            for (starts[0..runs], counts[0..runs]) |t0, cnt| try k.native_lane.matmulTiles(st, s.mixed + r0 * dims * 2, dims, m, n, head, out + r0 * vocab * 2, t0, cnt);
+        }
+        c.tiles += total;
+        c.runs += runs;
+        if (c.check) {
+            const chk = k.cert_chk orelse return error.UnexpectedTensor;
+            try k.native_lane.matmul(st, s.mixed, dims, n, head, c.chk.ptr, s.native_part);
+            var b: cuda.Args = .{};
+            b.add(out);
+            b.add(c.chk.ptr);
+            b.add(cint(vocab));
+            b.add(c.stats.ptr);
+            try cuda.launch.launch(chk, .{ .grid = .{ .x = @intCast(n) }, .block = .{ .x = 1024 } }, st, &b);
+        }
+        c.report(st);
+        return true;
+    }
+
+    fn report(c: *Cert, st: cuda.Stream) void {
+        const every: u64 = if (c.check) 1000 else 20000;
+        if (c.calls % every != 0) return;
+        var hs: [4]u32 = .{ 0, 0, 0, 0 };
+        if (c.check) {
+            st.synchronize() catch {};
+            _ = st.d.api.cuMemcpyDtoH_v2(&hs, c.stats.ptr, 16);
+        }
+        const done = @max(c.calls - c.fallbacks, 1);
+        std.debug.print("q38 cert: calls {d} rows {d} whole-head {d} tiles/call {d:.1} runs/call {d:.1} checked-rows {d} best-mismatch {d} value-mismatch {d} held {d}\n", .{ c.calls, c.rows, c.fallbacks, @as(f64, @floatFromInt(c.tiles)) / @as(f64, @floatFromInt(done)), @as(f64, @floatFromInt(c.runs)) / @as(f64, @floatFromInt(done)), hs[0], hs[1], hs[2], hs[3] });
+    }
+};
+
+test "E4M3 codes decode to the nearest value and never to NaN" {
+    var y: f32 = -460.0;
+    while (y < 460.0) : (y += 0.37) {
+        const c = encode(y);
+        try std.testing.expect((c & 0x7f) != 0x7f);
+        const v = decode(c);
+        const clamped: f64 = @max(-448.0, @min(448.0, @as(f64, y)));
+        try std.testing.expect(@abs(v - clamped) <= @max(@abs(clamped) / 16.0, 1.0 / 1024.0) * 1.0001);
+    }
+    try std.testing.expectEqual(@as(f64, 448.0), decode(encode(448.0)));
+    try std.testing.expectEqual(@as(f64, 0.015625), decode(encode(0.015625)));
+    try std.testing.expectEqual(@as(f64, 0.0), decode(encode(0.0)));
+}
diff --git a/zig/src/families/flashnext/cuda_knobs.zig b/zig/src/families/flashnext/cuda_knobs.zig
index baf8a3a..f701a57 100644
--- a/zig/src/families/flashnext/cuda_knobs.zig
+++ b/zig/src/families/flashnext/cuda_knobs.zig
@@ -81,3 +81,16 @@ pub fn gdnLanes() bool {
     const v = std.c.getenv("TF_FLASHNEXT_GDN_LANES") orelse return false;
     return std.mem.eql(u8, std.mem.span(v), "1");
 }
+
+var wide_rows_cache: usize = 0;
+/// TF_FLASHNEXT_Q38_WIDE_ROWS=N (q38; default 64, the stock value; 64 to 256): rows a shared drafted verify pass holds at most
+/// and the rows the lane core lets a round's drafts fill. With many streams a pass's cost grows slowly with its rows (the rows share
+/// experts), so a wider pass verifies more drafts a stream for little time. Drafts only: every kept token is still the target's.
+pub fn wideRows() usize {
