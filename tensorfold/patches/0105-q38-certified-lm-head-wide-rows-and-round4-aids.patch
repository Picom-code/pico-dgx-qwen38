 // The prompt GDN block in one kernel a value head (front, chain, gated norm; their bits), no fp32 rows through memory.
 #include "flashnext_gdn_fused.cuh"
+
+
+// ---- q38 certified LM head (TF_FLASHNEXT_Q38_CERT) ----
+// Program (row), 1024 threads. A [rows, V] fp32: a coarse copy of the head times the rows; c [V]: for each vocabulary row a bound
+// on |exact - coarse| per unit of ||x||. A row's best exact score is at least lo = max(A - c h) and at most hi = max(A + c h); an
+// entry whose A + c h is under lo less two bf16 steps cannot be, or tie with, the row's best after the head's bf16 rounding. The
+// 64-entry tiles holding any other entry are flagged; the row of `out` is filled with -inf (the exact kernel then writes the
+// flagged tiles). info [rows, 4]: lo, hi, threshold, h.
+extern "C" __global__ void __launch_bounds__(1024) fn_cert_select(const float* __restrict__ A, const float* __restrict__ c,
+                                                                  const __nv_bfloat16* __restrict__ x, int ldx, int K, int V,
+                                                                  __nv_bfloat16* __restrict__ out, unsigned* __restrict__ flags,
+                                                                  float* __restrict__ info) {
+    const int r = blockIdx.x, t = threadIdx.x, lane = t & 31, warp = t >> 5, warps = blockDim.x >> 5;
+    __shared__ float sa[32];
+    __shared__ float sb[32];
+    __shared__ float g0, g1;
+    const __nv_bfloat16* xr = x + static_cast<long long>(r) * ldx;
+    float s = 0.0f;
+    for (int i = t; i < K; i += blockDim.x) {
+        const float v = __bfloat162float(xr[i]);
+        s = s + v * v;
+    }
+    for (int o = 16; o; o >>= 1) s = s + __shfl_xor_sync(0xffffffffu, s, o);
+    if (lane == 0) sa[warp] = s;
+    __syncthreads();
+    if (warp == 0) {
+        s = lane < warps ? sa[lane] : 0.0f;
+        for (int o = 16; o; o >>= 1) s = s + __shfl_xor_sync(0xffffffffu, s, o);
+        if (lane == 0) g0 = sqrtf(s) * 1.0001f;
+    }
+    __syncthreads();
+    const float h = g0;
+    const float* a = A + static_cast<long long>(r) * V;
+    float lo = -CUDART_INF_F, hi = -CUDART_INF_F;
+    bool bad = false;
+    for (int i = t; i < V; i += blockDim.x) {
+        const float v = a[i], b = c[i] * h;
+        if (!(fabsf(v) < CUDART_INF_F)) bad = true;
+        lo = fmaxf(lo, v - b);
+        hi = fmaxf(hi, v + b);
+    }
+    if (bad) lo = CUDART_NAN_F;
+    for (int o = 16; o; o >>= 1) {
+        const float l2 = __shfl_xor_sync(0xffffffffu, lo, o), h2 = __shfl_xor_sync(0xffffffffu, hi, o);
+        lo = (lo != lo || l2 != l2) ? CUDART_NAN_F : fmaxf(lo, l2);
+        hi = fmaxf(hi, h2);
+    }
+    __syncthreads();
+    if (lane == 0) {
+        sa[warp] = lo;
+        sb[warp] = hi;
+    }
+    __syncthreads();
+    if (warp == 0) {
+        lo = lane < warps ? sa[lane] : -CUDART_INF_F;
+        hi = lane < warps ? sb[lane] : -CUDART_INF_F;
+        for (int o = 16; o; o >>= 1) {
+            const float l2 = __shfl_xor_sync(0xffffffffu, lo, o), h2 = __shfl_xor_sync(0xffffffffu, hi, o);
+            lo = (lo != lo || l2 != l2) ? CUDART_NAN_F : fmaxf(lo, l2);
+            hi = fmaxf(hi, h2);
+        }
+        if (lane == 0) {
+            g0 = lo;
+            g1 = hi;
+        }
+    }
+    __syncthreads();
+    lo = g0;
+    hi = g1;
+    const float m = fmaxf(fabsf(lo), fabsf(hi));
+    int e = 0;
+    frexpf(m, &e);                                       // m in [2^(e-1), 2^e): a bf16 step there is 2^(e-8)
+    const float step = ldexpf(1.0f, e - 8);
+    const float thr = lo - 2.0f * step - 1e-5f * (1.0f + m);
+    __nv_bfloat16* orow = out + static_cast<long long>(r) * V;
+    const __nv_bfloat16 ninf = __float2bfloat16_rn(-CUDART_INF_F);
+    for (int i = t; i < V; i += blockDim.x) {
+        if (a[i] + c[i] * h >= thr) flags[i >> 6] = 1u;
+        orow[i] = ninf;
+    }
