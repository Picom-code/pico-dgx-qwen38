+    out[4..8].* = attnRanges(h.kv, (&h.kc)[0..1], (&h.vc)[0..1], (&h.ikc)[0..1], (&h.pooled)[0..1], seg.from, seg.at);
+    return 8;
+}
+
+fn moveSeg(stream: cuda.Stream, seq: *prompt.Seq, d: ?*Draft, seg: *const Seg, way: Way) !void {
+    const dr = stream.d;
+    var rs: [8]Range = undefined;
+    const n = segRanges(seq, d, seg, &rs);
+    var off: u64 = 0;
+    for (rs[0..n]) |r| for (r.bufs) |b| {
+        if (r.n == 0) continue;
+        const dst, const src = if (way == .save) .{ seg.buf.ptr + off, b.ptr + r.off } else .{ b.ptr + r.off, seg.buf.ptr + off };
+        try dr.check(dr.api.cuMemcpyDtoDAsync_v2(dst, src, r.n, stream.handle), "cuMemcpyDtoDAsync");
+        off += r.n;
+    };
+    std.debug.assert(off <= seg.buf.len and (off == seg.buf.len or (seg.head and d == null)));
