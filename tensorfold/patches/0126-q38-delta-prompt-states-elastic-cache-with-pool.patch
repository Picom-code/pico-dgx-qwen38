+
+const Range = struct { bufs: []cuda.DeviceBuffer, off: usize, n: usize };
+
+fn attnRanges(format: Kv, kc: []cuda.DeviceBuffer, vc: []cuda.DeviceBuffer, ikc: []cuda.DeviceBuffer, pooled: []cuda.DeviceBuffer, from: usize, at: usize) [4]Range {
+    const pf = from / wt.index_ratio;
+    return .{
+        .{ .bufs = kc, .off = from * format.keyRow(), .n = (at - from) * format.keyRow() },
+        .{ .bufs = vc, .off = from * format.valueRow(), .n = (at - from) * format.valueRow() },
+        .{ .bufs = ikc, .off = from * index_row, .n = (at - from) * index_row },
+        .{ .bufs = pooled, .off = pf * index_row, .n = (at / wt.index_ratio - pf) * index_row },
+    };
