@@ -47,8 +47,249 @@ pub const Snap = struct {
     kv: Kv = .bf16,
     /// The format of the head's rows when it holds them.
     head_kv: Kv = .bf16,
+    /// q38 (TF_FLASHNEXT_Q38_SNAP_DELTA): the state's attention rows as a chain of shared row ranges; `buf` then holds only the
+    /// conv windows, DeltaNet states and n-gram tail.
+    seg: ?*Seg = null,
 };
 
+// -- q38 delta states (TF_FLASHNEXT_Q38_SNAP_DELTA=1; =2 also checks) ---------------------------------------------------------
+// A stream's attention caches are append-only: once row r of a key, value, indexer-key or pooled buffer is written it is never
+// written again while the stream lives (the check mode proves it on every keep). So two states of one conversation hold the same
+// bytes for the rows both cover. With the flag a kept state is its fixed pieces (a copy, as before) plus a reference-counted
+// chain of row ranges: its own rows [from, at) and, through `parent`, the ranges of the state its stream resumed from or kept
+// last. A restore copies the same bytes into the same places as a whole copy would; only where the kept bytes live changes.
+// (The idea of sharing prefix blocks between kept states: vLLM PagedAttention, SGLang RadixAttention, upstream TF_FLASHNEXT_KV_PAGES.)
+
+/// Bytes of a delta state's own buffer: the DeltaNet's conv windows and states and the n-gram tail.
+pub const fixed_bytes = wt.linear_n * (conv_bytes + state_bytes) + tail_bytes;
+
+/// Rows [from, at) of every attention cache (and the head's, with `head`), kept once and shared by every state that extends them.
+pub const Seg = struct {
+    buf: cuda.DeviceBuffer,
+    from: usize,
+    at: usize,
+    parent: ?*Seg,
+    /// Holders of the STRUCT: its state (while kept), each child range, each stream standing on it.
+    refs: u32 = 1,
+    /// Holders of the BYTES: its state (while kept) and each child range whose own bytes are still held. A stream standing on a
+    /// range does not hold its bytes: when the cache has evicted every state that needs them they are freed at once (`dead`), and
+    /// the stream's next keep is a whole copy again. (Otherwise evictions under pressure would free nothing while streams live.)
+    strong: u32 = 1,
+    dead: bool = false,
+    /// Its state is still kept (the prompt cache charges the bytes to that state); else they count as orphans.
+    owned: bool = true,
+    head: bool,
+    kv: Kv,
+    head_kv: Kv,
+};
+
+pub const DeltaStats = struct { keeps: u64 = 0, shared: u64 = 0, whole_bytes: u64 = 0, kept_bytes: u64 = 0, orphan: u64 = 0, restores: u64 = 0, chain_max: u64 = 0, check_bytes: u64 = 0, check_diff: u64 = 0 };
+var ds: DeltaStats = .{};
+var seg_gpa: std.mem.Allocator = undefined;
+var delta_mode: i8 = -1;
+
+/// TF_FLASHNEXT_Q38_SNAP_DELTA: 0 / unset off; 1 on; 2 on, and every keep compares the stream's rows with the chain it shares.
+pub fn deltaMode() u8 {
+    if (delta_mode < 0) delta_mode = if (std.c.getenv("TF_FLASHNEXT_Q38_SNAP_DELTA")) |e| (if (e[0] == '1') @as(i8, 1) else if (e[0] == '2') @as(i8, 2) else 0) else 0;
+    return @intCast(delta_mode);
+}
+
+pub fn deltaStats() DeltaStats {
+    return ds;
+}
+
+/// Bytes of shared row ranges whose own state is gone while a later state or a stream still needs them: inside the cache's budget.
+pub fn orphans() u64 {
+    return ds.orphan;
+}
+
+/// The device bytes `snap` holds for the cache's accounts: its buffer and its own row range.
+pub fn held(snap: *const Snap) u64 {
+    return snap.buf.len + if (snap.seg) |g| g.buf.len else 0;
+}
+
+fn attnRange(format: Kv, from: usize, at: usize) usize {
+    return (at - from) * format.position() + (at / wt.index_ratio - from / wt.index_ratio) * index_row;
+}
+
+fn segBytes(format: Kv, head_format: ?Kv, from: usize, at: usize) usize {
+    return wt.attn_n * attnRange(format, from, at) + if (head_format) |h| attnRange(h, from, at) else 0;
+}
+
+/// Whether a new range of a stream in `kv` (drafting: `head_kv`) may extend `base`: the same formats, the same pieces.
+fn extends(base: ?*const Seg, kv: Kv, head_kv: ?Kv, at: usize) bool {
+    const b = base orelse return false;
+    if (b.dead or b.at > at or b.kv != kv or b.head != (head_kv != null)) return false;
+    if (head_kv) |h| if (b.head_kv != h) return false;
+    return true;
+}
+
+/// What a keep at `at` would newly take for a stream standing on `base` (the cache checks its budget with this).
+pub fn needBytes(base: ?*const Seg, kv: Kv, head_kv: ?Kv, at: usize) u64 {
+    const from = if (extends(base, kv, head_kv, at)) base.?.at else 0;
+    return fixed_bytes + segBytes(kv, head_kv, from, at);
