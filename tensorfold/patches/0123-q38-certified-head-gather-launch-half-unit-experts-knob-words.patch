+extern "c" fn clock_gettime(clk: c_int, ts: *[2]i64) c_int;
+/// TF_FLASHNEXT_Q38_KNOBFILE=path (q38 measuring aid, off unless set): a small text file of `name=value` words (at most 32 words, 512
+/// bytes), read again every 200 ms and kept as a parsed table, so one running engine can be switched between a lever's settings for
+/// paired timing and a knob read costs a clock read and a short scan. null: no file, or no such name.
+pub fn knobFile(name: []const u8) ?i64 {
+    const st = struct {
+        var init: bool = false;
+        var path: ?[*:0]const u8 = null;
+        var names: [32][24]u8 = undefined;
+        var lens: [32]u8 = undefined;
+        var vals: [32]i64 = undefined;
+        var n: usize = 0;
+        var at_ns: u64 = 0;
+        var have: bool = false;
+    };
+    if (!st.init) {
+        st.path = std.c.getenv("TF_FLASHNEXT_Q38_KNOBFILE");
+        st.init = true;
+    }
+    const path = st.path orelse return null;
+    var ts: [2]i64 = .{ 0, 0 };
+    _ = clock_gettime(1, &ts);
+    const now = @as(u64, @intCast(ts[0])) * 1_000_000_000 + @as(u64, @intCast(ts[1]));
+    if (!st.have or now -% st.at_ns > 200_000_000) {
+        st.at_ns = now;
+        var buf: [512]u8 = undefined;
+        var len: usize = 0;
+        const fd = std.c.open(path, .{ .ACCMODE = .RDONLY, .CLOEXEC = true }, @as(std.c.mode_t, 0));
+        if (fd >= 0) {
+            const got = std.c.pread(fd, &buf, buf.len, 0);
+            if (got > 0) len = @intCast(got);
+            _ = std.c.close(fd);
+        }
+        var m: usize = 0;
+        var it = std.mem.tokenizeAny(u8, buf[0..len], "\n \t");
+        while (it.next()) |w| {
+            if (m == 32) break;
+            const eq = std.mem.indexOfScalar(u8, w, '=') orelse continue;
+            if (eq == 0 or eq > 24) continue;
+            const v = std.fmt.parseInt(i64, w[eq + 1 ..], 10) catch continue;
+            @memcpy(st.names[m][0..eq], w[0..eq]);
+            st.lens[m] = @intCast(eq);
+            st.vals[m] = v;
+            m += 1;
+        }
+        st.n = m;
+        st.have = true;
+    }
+    var i: usize = 0;
+    while (i < st.n) : (i += 1) {
+        if (st.lens[i] == name.len and std.mem.eql(u8, st.names[i][0..name.len], name)) return st.vals[i];
+    }
+    return null;
+}
