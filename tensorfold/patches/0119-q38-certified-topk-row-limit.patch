--- a/zig/src/families/flashnext/cuda_cert.zig
+++ b/zig/src/families/flashnext/cuda_cert.zig
@@ -45,6 +45,17 @@ pub fn topkMax() u32 {
     return @intCast(topk_cache);
 }
 
+var topk_rows_cache: i32 = -1;
+/// TF_FLASHNEXT_Q38_CERT_TOPK_ROWS=N (q38; default 8; 0: no limit): a top-k pass of more than N rows takes the whole head at once. Each
+/// sampled row keeps ~80 exact tiles, so a wide pass of many sampled streams would run the coarse pass and then fall back over the tile limit.
+pub fn topkRows() usize {
+    if (topk_rows_cache < 0) {
+        topk_rows_cache = 8;
+        if (std.c.getenv("TF_FLASHNEXT_Q38_CERT_TOPK_ROWS")) |e| topk_rows_cache = @intCast(@min(4096, std.fmt.parseInt(u32, std.mem.span(e), 10) catch 8));
+    }
+    return @intCast(topk_rows_cache);
+}
+
 var code_cache: i8 = -1;
 /// TF_FLASHNEXT_Q38_CERT_CODE=sm8 (q38; default mxfp8): the coarse copy holds sign-magnitude 7-bit integer codes with a power-of-two
 /// scale per 32 inputs (qmmf.cu SM8: the same bytes a row as the MXFP8 copy, about a third of its error), instead of E4M3 codes.
@@ -142,6 +153,7 @@ pub const Cert = struct {
     resid: f64 = 0,
     sm8: bool = false,
     kcalls: u64 = 0,
+    kskipped: u64 = 0,
