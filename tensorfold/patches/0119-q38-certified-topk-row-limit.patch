     ktiles: u64 = 0,
     kruns: u64 = 0,
@@ -252,6 +264,10 @@ pub const Cert = struct {
         const s = pass.s;
         const d = st.d;
         const kk: u32 = @max(1, round_k);
+        if (kk > 1 and topkRows() != 0 and n > topkRows()) {
+            c.kskipped += 1;
+            return false;
+        }
         const sel = (if (kk > 1) k.cert_selk else k.cert_sel) orelse return false;
         const head = pass.m.head.native orelse return false;
         if (head.mode != .bf16 or head.n != vocab or head.k != dims) return false;
@@ -380,8 +396,9 @@ pub const Cert = struct {
         }
         const done = @max(c.calls - c.fallbacks, 1);
         std.debug.print("q38 cert: calls {d} rows {d} whole-head {d} tiles/call {d:.1} runs/call {d:.1} checked-rows {d} best-mismatch {d} value-mismatch {d} held {d}\n", .{ c.calls, c.rows, c.fallbacks, @as(f64, @floatFromInt(c.tiles)) / @as(f64, @floatFromInt(done)), @as(f64, @floatFromInt(c.runs)) / @as(f64, @floatFromInt(done)), hs[0], hs[1], hs[2], hs[3] });
-        if (c.kcalls > 0 or c.check) {
+        if (c.kcalls > 0 or c.kskipped > 0 or c.check) {
             const kdone = @max(c.kcalls - c.kfallbacks, 1);
+            std.debug.print("q38 cert topk: wide passes not tried {d}\n", .{c.kskipped});
             std.debug.print("q38 cert topk: calls {d} whole-head {d} tiles/call {d:.1} runs/call {d:.1} topk-rows-checked {d} topk-mismatch {d} bound-violations {d} of {d} K entries\n", .{ c.kcalls, c.kfallbacks, @as(f64, @floatFromInt(c.ktiles)) / @as(f64, @floatFromInt(kdone)), @as(f64, @floatFromInt(c.kruns)) / @as(f64, @floatFromInt(kdone)), c.topk_checked, c.topk_mismatch, hs[4], hs[5] });
         }
