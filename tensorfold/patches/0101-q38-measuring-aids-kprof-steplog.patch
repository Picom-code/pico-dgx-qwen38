+extern "c" fn clock_gettime(clk: c_int, ts: *[2]i64) c_int;
+
+/// TF_KPROF=N (q38 profiling aid, off unless set): every launch is bracketed by stream synchronizations and its wall time
+/// is summed by kernel; every N launches the table goes to stderr ("kprof <name> calls ns blocks") and restarts.
+/// It serialises the GPU (no overlap, no PDL benefit) and must not be combined with captured decode graphs.
+const KProf = struct {
+    const Slot = struct { h: usize = 0, n: u64 = 0, ns: u64 = 0, blocks: u64 = 0 };
+    var state: i64 = -1;
+    var slots: [1024]Slot = @splat(.{});
+    var launches: u64 = 0;
+    var busy: u8 = 0;
+
+    fn on() bool {
+        if (state < 0) {
+            var v: i64 = 0;
+            if (std.c.getenv("TF_KPROF")) |e| v = std.fmt.parseInt(i64, std.mem.span(e), 10) catch 0;
+            state = if (v > 0) v else 0;
+        }
+        return state > 0;
+    }
+
+    fn now() u64 {
+        var ts: [2]i64 = .{ 0, 0 };
+        _ = clock_gettime(1, &ts);
+        return @as(u64, @intCast(ts[0])) * 1_000_000_000 + @as(u64, @intCast(ts[1]));
+    }
+
+    fn add(d: anytype, handle: abi.Function, cfg: Config, ns: u64) void {
+        while (@atomicRmw(u8, &busy, .Xchg, 1, .acquire) != 0) {}
+        defer @atomicStore(u8, &busy, 0, .release);
+        const h: usize = @intFromPtr(handle);
+        var i: usize = (h >> 4) % slots.len;
+        var probes: usize = 0;
+        while (slots[i].h != 0 and slots[i].h != h and probes < slots.len) : (probes += 1) i = (i + 1) % slots.len;
+        if (slots[i].h == 0 or slots[i].h == h) {
+            slots[i].h = h;
+            slots[i].n += 1;
+            slots[i].ns += ns;
+            slots[i].blocks += @as(u64, cfg.grid.x) * cfg.grid.y * cfg.grid.z;
+        }
+        launches += 1;
+        if (launches % @as(u64, @intCast(state)) == 0) {
+            std.debug.print("kprof-begin launches {d}\n", .{launches});
+            for (&slots) |*sl| {
+                if (sl.h == 0) continue;
+                const fh: abi.Function = @ptrFromInt(sl.h);
+                std.debug.print("kprof {s} {d} {d} {d}\n", .{ d.functionName(fh), sl.n, sl.ns, sl.blocks });
+                sl.* = .{};
+            }
+            std.debug.print("kprof-end\n", .{});
+        }
+    }
+};
+
